<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LensSplitter.Cli</RootNamespace>
    <AssemblyName>lenssplitter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LensSplitter.Core\LensSplitter.Core.csproj" />
  </ItemGroup>

  <!-- AberrationCalculator's glass catalogs: every vendor's, for reading lenses (catalogs/Glass),
       and the CoreSet28 working set the glass search chooses from (catalogs/Substitution). -->
  <ItemGroup>
    <None Include="..\..\external\AberrationCalculator\catalogs\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="catalogs" />
  </ItemGroup>
</Project>
