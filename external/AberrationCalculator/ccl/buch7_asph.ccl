/**********************************************************************
* cmd buch7_asph - third-, fifth- and seventh-order Buchdahl coefficients
* of a centred system that may carry conics and even aspheres, as system
* totals and SURFACE BY SURFACE.
*
* Written by Javier Ruiz with Claude Code, September 2026. The OSLO port
* of macros/BUCH7_ASPH.ZPL in C:\GIT\AberrationCalculator. The front end
* (lens data, the two paraxial rays) is written for OSLO; everything from
* the macro's stage A on is translated from the macro statement for
* statement by tools/zpl2ccl.py, so the arithmetic is the macro's own. The
* macro and this program's C# are the references it is checked against.
*
* REFERENCES
*
*   H. A. Buchdahl, "Optical Aberration Coefficients", Dover 1968: Secs.
*   41-44 (the fifth order, intrinsic and induced), 60, 65, 77-79 (the
*   aspheric contributions), 84-85 (the tertiary scheme).
*   H. A. Buchdahl, J. Opt. Soc. Am. 48, 563 (1958) (paper II) and 48, 747
*   (1958) (paper III, Tables I and II).
*
* WHAT IT PRINTS
*
*   The third order (B F C Pi E), the fifth order (B5 F1 F2 M1 M2 M3 N1
*   N2 N3 C5 Pi5 E5), B7, and the twenty seventh-order tau, as system
*   totals in transverse measure.
*
*   With the first argument 1 (the default), also every surface:
*
*     - the third and fifth order and B7 split three ways. INTRINSIC is
*       what the surface generates from its own curvature, indices and
*       the rays arriving at it; FIGURING what its conic and AD, AE, AF
*       add; INDUCED what the aberration already accumulated ahead of it
*       produces in it. There is no induced term at third order;
*     - each surface's induced share of its fifth order;
*     - the twenty tau, surface by surface. These are per-surface totals:
*       the seventh order is not split into intrinsic and induced, as the
*       macro explains - no published derivation separates them.
*
*   Each column adds down to the system total printed with it.
*
* RUNNING IT
*
*   buch7_asph               per surface, current wavelength, report file
*   buch7_asph 0             system totals only
*   buch7_asph 1 2           at wavelength 2
*   buch7_asph 1 0 0         without the report file
*
*   The report is added to the end of B7_REPORT (below), as well as going
*   to the text window, so several lenses can be run into one file. Set
*   it to a folder that exists; if it cannot be written, buch7_asph says
*   so and carries on without it.
*
* LIMITS
*
*   Plane, spherical, conic and standard aspheric (AD, AE, AF) surfaces.
*   AG, the r^10 term, cannot reach the seventh order and takes no part.
*   Any other surface type - toric, spline, general asphere, perfect lens
*   - is declined. A figured flat facing collimated light is declined for
*   the seventh order (the third and fifth still stand). Rotationally
*   symmetric and sequential; either conjugate; mirrors are carried in
*   the sign of the index. At most 16 surfaces between object and image:
*   the arrays are sized to fit CCL's 1 MB of global storage, which OSLO's
*   own CCL shares.
**********************************************************************/

#define B7_REPORT  "C:/GIT/AberrationCalculator/ccl/buch7_asph.txt"
#define B7_MAXS    18

int b7_srfarg  {prompt = "Surface by surface (0 = system totals only, 1 = per surface)", lolim = 0, hilim = 1, default(noquery) = 1}
int b7_wavarg  {prompt = "Wavelength number (0 = the current one)", lolim = 0, hilim = 10, default(noquery) = 0}
int b7_filearg {prompt = "Also write the report file B7_REPORT (0 = no, 1 = yes)", lolim = 0, hilim = 1, default(noquery) = 1}

static double b7_ns[B7_MAXS];        // index after surface i, signed by the mirror count
static double b7_ya[B7_MAXS], b7_ua[B7_MAXS];   // basis ray, and the scratch the trace writes
static double b7_ym[B7_MAXS], b7_um[B7_MAXS];   // marginal: height at i, slope after i
static double b7_yc[B7_MAXS], b7_uc[B7_MAXS];   // chief
static double b7_vfm[B7_MAXS][8];    // vertex form: curvature, conic, A4, A6, A8, figured
static int    b7_nsm;
static int    b7_fh, b7_wf;
static char   b7_ln[400];

// One line to the text window and, if it is open, the report.
static cmd
b7_out()
{
	printf("%s\n", b7_ln);
	if (b7_wf)
		fprintf(b7_fh, "%s\n", b7_ln);
	strcpy(b7_ln, "");
}

// The paraxial ray with height y1 at surface 1 and slope u0 in object space, through every
// optical surface: b7_ya[i] its height at surface i, b7_ua[i] its slope after surface i,
// b7_ua[0] the object-space slope. The same recurrence as ParaxialTrace.Propagate.
static int
b7_prop(double pr_y1, double pr_u0)
{
	int    pr_i;
	double pr_om, pr_t;

	b7_ua[0] = pr_u0;
	b7_ya[0] = 0.0;
	pr_om = b7_ns[0]*pr_u0;
	b7_ya[1] = pr_y1;
	for (pr_i = 1; pr_i <= b7_nsm; pr_i++)
	{
		pr_om = pr_om - b7_ya[pr_i]*(b7_ns[pr_i] - b7_ns[pr_i - 1])*cv[pr_i];
		b7_ua[pr_i] = pr_om/b7_ns[pr_i];
		if (pr_i < b7_nsm)
		{
			pr_t = th[pr_i];
			b7_ya[pr_i + 1] = b7_ya[pr_i] + pr_t*b7_ua[pr_i];
		}
	}
	return (0);
}


