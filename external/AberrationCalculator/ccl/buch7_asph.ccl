			z_tt[z_tdb][66] = z_sv[2][14];
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_tt[z_tdb][120 + z_k] = z_sv[3][z_k];
			}
		}
	}
	if (z_chk == 1)
	{
