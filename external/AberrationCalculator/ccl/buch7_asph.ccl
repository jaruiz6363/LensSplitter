static int
z_zero()
{
	int zi, zj;
	for (zi = 0; zi < 19; zi++) for (zj = 0; zj < 9; zj++) z_vfm[zi][zj] = 0;
	for (zi = 0; zi < 3; zi++) for (zj = 0; zj < 13; zj++) z_cub[zi][zj] = 0;
	for (zi = 0; zi < 7; zi++) for (zj = 0; zj < 71; zj++) z_mon[zi][zj] = 0;
	for (zi = 0; zi < 3; zi++) for (zj = 0; zj < 69; zj++) z_scr[zi][zj] = 0;
	for (zi = 0; zi < 37; zi++) for (zj = 0; zj < 19; zj++) z_mq[zi][zj] = 0;
	for (zi = 0; zi < 19; zi++) for (zj = 0; zj < 61; zj++) z_fo[zi][zj] = 0;
	for (zi = 0; zi < 41; zi++) for (zj = 0; zj < 67; zj++) z_pw[zi][zj] = 0;
	for (zi = 0; zi < 19; zi++) for (zj = 0; zj < 113; zj++) z_pc[zi][zj] = 0;
	for (zi = 0; zi < 19; zi++) for (zj = 0; zj < 5; zj++) z_pcf[zi][zj] = 0;
	for (zi = 0; zi < 79; zi++) for (zj = 0; zj < 161; zj++) z_tt[zi][zj] = 0;
	for (zi = 0; zi < 79; zi++) for (zj = 0; zj < 31; zj++) z_yf[zi][zj] = 0;
	for (zi = 0; zi < 79; zi++) for (zj = 0; zj < 80; zj++) z_rv[zi][zj] = 0;
	for (zi = 0; zi < 79; zi++) for (zj = 0; zj < 9; zj++) z_ai[zi][zj] = 0;
	for (zi = 0; zi < 5; zi++) for (zj = 0; zj < 10; zj++) z_bw[zi][zj] = 0;
	for (zi = 0; zi < 13; zi++) for (zj = 0; zj < 13; zj++) z_sc[zi][zj] = 0;
	for (zi = 0; zi < 9; zi++) for (zj = 0; zj < 9; zj++) z_dh[zi][zj] = 0;
	for (zi = 0; zi < 5; zi++) for (zj = 0; zj < 13; zj++) z_tz[zi][zj] = 0;
	for (zi = 0; zi < 13; zi++) for (zj = 0; zj < 13; zj++) z_po[zi][zj] = 0;
	for (zi = 0; zi < 6; zi++) for (zj = 0; zj < 33; zj++) z_sv[zi][zj] = 0;
	for (zi = 0; zi < 19; zi++) for (zj = 0; zj < 23; zj++) z_pt[zi][zj] = 0;
	for (zi = 0; zi < 19; zi++) for (zj = 0; zj < 23; zj++) z_tw[zi][zj] = 0;
	for (zi = 0; zi < 520; zi++) z_vec2[zi] = 0.0;
	for (zi = 0; zi < 520; zi++) z_vec3[zi] = 0.0;
	for (zi = 0; zi < 42; zi++) z_vec4[zi] = 0.0;
	return (0);
}

// ---- generated: the macro's subroutines ----
static int
z_s_pmk()
{
	for (z_ka = 1; z_ka <= 64; z_ka = z_ka + (1))
	{
		z_mon[1][z_ka] = 0;
	}
	z_km = 0;
	for (z_kd = 0; z_kd <= 3; z_kd = z_kd + (1))
	{
		for (z_ka = z_kd; z_ka >= 0; z_ka = z_ka + (-1))
		{
			for (z_kb = z_kd - z_ka; z_kb >= 0; z_kb = z_kb + (-1))
			{
				z_kc = z_kd - z_ka - z_kb;
				z_km = z_km + 1;
				z_mon[1][1 + z_ka * 16 + z_kb * 4 + z_kc] = z_km;
				z_mon[2][z_km] = z_ka;
				z_mon[3][z_km] = z_kb;
				z_mon[4][z_km] = z_kc;
				z_mon[5][z_km] = 1 + z_ka * 16 + z_kb * 4 + z_kc;
			}
		}
	}
	z_nmon = z_km;
	z_mon[6][1] = 0;
	z_mon[6][2] = 1;
	z_mon[6][3] = 2;
	z_mon[6][4] = 2;
	z_mon[6][5] = 3;
	z_mon[6][6] = 4;
	z_mon[6][7] = 3;
	z_mon[6][8] = 4;
	z_mon[6][9] = 5;
	z_mon[6][10] = 6;
	return (0);
}

static int
z_s_pmul()
{
	z_pmsa = z_ga;
	z_pmsb = z_gb;
	z_pmsc = z_gc;
	for (z_pmj = 1; z_pmj <= 64; z_pmj = z_pmj + (1))
	{
		z_scr[1][z_pmj] = 0;
	}
	for (z_pmi = 1; z_pmi <= z_nmon; z_pmi = z_pmi + (1))
	{
		z_pmu = z_pw[z_pmsa][z_mon[5][z_pmi]];
		if (z_pmu != 0)
		{
			z_pma = z_mon[2][z_pmi];
			z_pmb = z_mon[3][z_pmi];
			z_pmc = z_mon[4][z_pmi];
			for (z_pmk2 = 1; z_pmk2 <= z_nmon; z_pmk2 = z_pmk2 + (1))
			{
				z_pmv = z_pw[z_pmsb][z_mon[5][z_pmk2]];
				if (z_pmv != 0)
				{
					z_pmd = z_pma + z_mon[2][z_pmk2];
					z_pme = z_pmb + z_mon[3][z_pmk2];
					z_pmf = z_pmc + z_mon[4][z_pmk2];
					if (z_pmd + z_pme + z_pmf < 4)
					{
						z_pmx = 1 + z_pmd * 16 + z_pme * 4 + z_pmf;
						z_scr[1][z_pmx] = z_scr[1][z_pmx] + z_pmu * z_pmv;
					}
				}
			}
		}
	}
	for (z_pmj = 1; z_pmj <= 64; z_pmj = z_pmj + (1))
	{
		z_pw[z_pmsc][z_pmj] = z_scr[1][z_pmj];
	}
	return (0);
}

static int
z_s_pcubs()
{
	z_pqs = z_ga;
	z_cub[1][1] = z_pw[z_pqs][1 + 3 * 16];
	z_cub[1][2] = z_pw[z_pqs][1 + 2 * 16 + 4];
	z_cub[1][3] = z_pw[z_pqs][1 + 2 * 16 + 1];
	z_cub[1][4] = z_pw[z_pqs][1 + 16 + 2 * 4];
	z_cub[1][5] = z_pw[z_pqs][1 + 16 + 4 + 1];
	z_cub[1][6] = z_pw[z_pqs][1 + 16 + 2];
	z_cub[1][7] = z_pw[z_pqs][1 + 3 * 4];
	z_cub[1][8] = z_pw[z_pqs][1 + 2 * 4 + 1];
	z_cub[1][9] = z_pw[z_pqs][1 + 4 + 2];
	z_cub[1][10] = z_pw[z_pqs][1 + 3];
	return (0);
}

static int
z_s_pquad()
{
	z_pqq = z_ga;
	z_cub[1][1] = z_pw[z_pqq][1 + 2 * 16];
	z_cub[1][2] = z_pw[z_pqq][1 + 16 + 4];
	z_cub[1][3] = z_pw[z_pqq][1 + 16 + 1];
	z_cub[1][4] = z_pw[z_pqq][1 + 2 * 4];
	z_cub[1][5] = z_pw[z_pqq][1 + 4 + 1];
	z_cub[1][6] = z_pw[z_pqq][1 + 2];
	return (0);
}

static int
z_s_pcub3()
{
	z_ga = 3;
	z_s_pcubs();
	return (0);
}

static int
