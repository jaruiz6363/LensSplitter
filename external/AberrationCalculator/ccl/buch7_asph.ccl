				strcat(b7_ln, "   chkb "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][1] - z_po[4][1])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][2] - z_po[4][2])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][3] - z_po[4][3])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][4] - z_po[4][4])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][5] - z_po[4][5])); strcat(b7_ln, b7_tmp); b7_out();
				strcat(b7_ln, "        "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][6] - z_po[4][6])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][7] - z_po[4][7])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][8] - z_po[4][8])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][9] - z_po[4][9])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[2][10] - z_po[4][10])); strcat(b7_ln, b7_tmp); b7_out();
				strcat(b7_ln, "   z hat"); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][1])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][2])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][3])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][4])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][5])); strcat(b7_ln, b7_tmp); b7_out();
				strcat(b7_ln, "        "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][6])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][7])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][8])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][9])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[4][10])); strcat(b7_ln, b7_tmp); b7_out();
				strcat(b7_ln, "   chain"); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[5][1])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[5][2])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[5][3])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[5][4])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sv[5][5])); strcat(b7_ln, b7_tmp); b7_out();
			}
			for (z_k = 1; z_k <= 9; z_k = z_k + (1))
			{
