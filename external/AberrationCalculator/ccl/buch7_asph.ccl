		z_z = z_z - (z_acpi + 4 * z_accb) * z_ba;
		z_tf2 = z_if2 + z_z / (2 * z_lag);
		z_z = z_acb * z_ea + (4 * z_acf - z_aceb) * z_ca - z_acfb * z_ba;
		z_z = z_z + (z_acc - 4 * z_accb - 2 * z_acpi) * z_fa;
		z_tm1 = z_im1 + z_z / z_lag;
		z_z = z_acb * z_ea + (2 * z_acf - z_aceb) * (z_pz + z_ca);
		z_z = z_z + (3 * z_acc - 2 * z_accb + z_acpi) * z_fa - 3 * z_acfb * z_ba;
		z_tm2 = z_im2 + z_z / (2 * z_lag);
		z_z = z_acf * (z_pz + 2 * z_ca) - z_acfb * z_ba + (z_acc - 2 * z_accb) * z_fa;
		z_tm3 = z_im3 + 2 * z_z / z_lag;
		z_z = 3 * z_acf * z_ea - (z_acpi + z_accb) * (z_pz + z_ca) + 2 * (z_acc - z_accb) * z_ca;
		z_z = z_z + (z_ace - 2 * z_acfb) * z_fa - z_acbb * z_ba;
		z_tn1 = z_in1 + z_z / (2 * z_lag);
		z_z = 3 * z_acf * z_ea + (z_acpi - z_accb + 3 * z_acc) * (z_pz + 3 * z_ca);
		z_z = z_z - z_acbb * z_ba;
		z_z = z_z - (z_acpi + z_acc) * z_ca;
		z_z = z_z + (z_ace - 8 * z_acfb) * z_fa;
		z_tn2 = z_in2 + z_z / z_lag;
		z_z = z_acf * z_ea + (3 * z_acc + z_acpi - z_accb) * (z_pz + z_ca) - z_acbb * z_ba;
		z_z = z_z + (z_acpi + z_acc) * z_ca + (z_ace - 4 * z_acfb) * z_fa;
		z_tn3 = z_in3 + z_z / (2 * z_lag);
		z_z = (4 * z_acc + z_acpi) * z_ea - z_acfb * z_pz + 2 * (z_ace - 2 * z_acfb) * z_ca;
		z_z = z_z - 2 * z_acbb * z_fa;
		z_tc5 = z_ic5 + z_z / (4 * z_lag);
		z_z = (z_acpi - 2 * z_acc) * z_ea + (4 * z_ace - z_acfb) * z_pz;
		z_z = z_z - 2 * z_acbb * z_fa;
		z_z = z_z + 2 * (z_ace + z_acfb) * z_ca;
		z_tp5 = z_ip5 + z_z / (4 * z_lag);
		z_te5 = z_ie5 + (3 * z_ace * z_ea - z_acbb * (z_pz + 3 * z_ca)) / (2 * z_lag);
		z_te5b = z_ie5b + (z_acb * (z_pz + 3 * z_cb) - 3 * z_aceb * z_eb) / (2 * z_lag);
		z_fo[z_i][30] = z_tb5;
		z_fo[z_i][31] = z_tf1;
		z_fo[z_i][32] = z_tf2;
		z_fo[z_i][33] = z_tm1;
		z_fo[z_i][34] = z_tm2;
		z_fo[z_i][35] = z_tm3;
		z_fo[z_i][36] = z_tn1;
		z_fo[z_i][37] = z_tn2;
		z_fo[z_i][38] = z_tn3;
		z_fo[z_i][39] = z_tc5;
		z_fo[z_i][40] = z_tp5;
		z_fo[z_i][23] = z_te5;
		z_fo[z_i][24] = z_tb7;
		z_acb = z_acb + z_ba;
		z_acf = z_acf + z_fa;
		z_acc = z_acc + z_ca;
		z_ace = z_ace + z_ea;
		z_acpi = z_acpi + z_pz;
		z_acbb = z_acbb + z_bb;
		z_acfb = z_acfb + z_fb;
		z_accb = z_accb + z_cb;
		z_aceb = z_aceb + z_eb;
		z_acb5 = z_acb5 + z_tb5;
		z_ace5b = z_ace5b + z_te5b;
	}
	return (0);
}

static int
z_part4()
{
	for (z_rs = 1; z_rs <= 2; z_rs = z_rs + (1))
	{
		z_acb = 0;
		z_acf = 0;
		z_acc = 0;
		z_ace = 0;
		z_acpi = 0;
		z_acbb = 0;
		z_acfb = 0;
		z_accb = 0;
		z_aceb = 0;
		z_acb5 = 0;
		z_ace5b = 0;
		for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
		{
			z_part1();
			z_part2();
			z_part3();
		}
	}
	z_sumb = 0;
	z_sumf = 0;
	z_sumc = 0;
	z_sump = 0;
	z_sume = 0;
	z_sb5 = 0;
	z_sf1 = 0;
	z_sf2 = 0;
	z_sm1 = 0;
	z_sm2 = 0;
	z_sm3 = 0;
	z_sn1 = 0;
	z_sn2 = 0;
	z_sn3 = 0;
	z_sc5 = 0;
	z_sp5 = 0;
	z_se5 = 0;
	z_sb7 = 0;
	for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
	{
		z_sumb = z_sumb + z_fo[z_i][1];
		z_sumf = z_sumf + z_fo[z_i][2];
		z_sumc = z_sumc + z_fo[z_i][3];
		z_sump = z_sump + z_fo[z_i][4];
		z_sume = z_sume + z_fo[z_i][5];
		z_sb5 = z_sb5 + z_fo[z_i][30];
		z_sf1 = z_sf1 + z_fo[z_i][31];
		z_sf2 = z_sf2 + z_fo[z_i][32];
		z_sm1 = z_sm1 + z_fo[z_i][33];
		z_sm2 = z_sm2 + z_fo[z_i][34];
		z_sm3 = z_sm3 + z_fo[z_i][35];
		z_sn1 = z_sn1 + z_fo[z_i][36];
		z_sn2 = z_sn2 + z_fo[z_i][37];
		z_sn3 = z_sn3 + z_fo[z_i][38];
		z_sc5 = z_sc5 + z_fo[z_i][39];
		z_sp5 = z_sp5 + z_fo[z_i][40];
		z_se5 = z_se5 + z_fo[z_i][23];
		z_sb7 = z_sb7 + z_fo[z_i][24];
	}
	strcat(b7_ln, "Third and fifth order, per surface, unconverted - multiply by the F/number"); b7_out();
	strcat(b7_ln, "above for a transverse aberration in lens units, which is done for the totals."); b7_out();
	strcat(b7_ln, " "); b7_out();
	strcat(b7_ln, " Surf              B              F              C             Pi              E"); b7_out();
	for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
	{
		sprintf(b7_tmp, "%5.0f", 1.0*(z_i)); strcat(b7_ln, b7_tmp);
		sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][1])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][2])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][3])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][4])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][5])); strcat(b7_ln, b7_tmp); b7_out();
	}
	strcat(b7_ln, " "); b7_out();
	strcat(b7_ln, "  SUM");
	sprintf(b7_tmp, "%15.6e", 1.0*(z_sumb)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sumf)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sumc)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sump)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_sume)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, " "); b7_out();
	strcat(b7_ln, "System totals, transverse measure"); b7_out();
	strcat(b7_ln, "   B  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sumb * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   F  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sumf * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   C  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sumc * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   Pi "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sump * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   E  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sume * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   B5 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sb5 * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   F1 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sf1 * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   F2 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sf2 * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   M1 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sm1 * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   M2 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sm2 * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   M3 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sm3 * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   N1 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sn1 * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   N2 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sn2 * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   N3 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sn3 * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   C5 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sc5 * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   Pi5"); sprintf(b7_tmp, "%15.6e", 1.0*(z_sp5 * z_fnum)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   E5 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_se5 * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   B7 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_sb7 * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, " "); b7_out();
	if (z_srf == 1)
	{
		z_uz = 0;
		strcat(b7_ln, " "); b7_out();
		strcat(b7_ln, "==============================================================================="); b7_out();
		strcat(b7_ln, "THIRD AND FIFTH ORDER, SURFACE BY SURFACE - intrinsic, figuring, induced."); b7_out();
		strcat(b7_ln, "Transverse measure. Each column adds down to the system total printed above."); b7_out();
		strcat(b7_ln, "==============================================================================="); b7_out();
		for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
		{
			strcat(b7_ln, " "); b7_out();
			if (z_vfm[z_i][6] == 1)
			{
				strcat(b7_ln, "Surface "); sprintf(b7_tmp, "%3.0f", 1.0*(z_i)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   (figured)"); b7_out();
			}
			else
			{
				strcat(b7_ln, "Surface "); sprintf(b7_tmp, "%3.0f", 1.0*(z_i)); strcat(b7_ln, b7_tmp); strcat(b7_ln, "   (spherical)"); b7_out();
			}
			strcat(b7_ln, "                          B              F              C             Pi              E"); b7_out();
			strcat(b7_ln, "   intrinsic  "); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][1] - z_fo[z_i][41]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][2] - z_fo[z_i][42]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][3] - z_fo[z_i][43]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][4] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][5] - z_fo[z_i][44]) * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   figuring   "); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][41] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][42] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][43] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_uz)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][44] * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   TOTAL      "); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][1] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][2] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][3] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][4] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][5] * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "                         B5             F1             F2             M1             M2"); b7_out();
			strcat(b7_ln, "   intrinsic  "); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][10] - z_fo[z_i][45]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][11] - z_fo[z_i][46]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][12] - z_fo[z_i][47]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][13] - z_fo[z_i][48]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][14] - z_fo[z_i][49]) * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   figuring   "); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][45] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][46] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][47] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][48] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][49] * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   induced    "); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][30] - z_fo[z_i][10]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][31] - z_fo[z_i][11]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][32] - z_fo[z_i][12]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][33] - z_fo[z_i][13]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][34] - z_fo[z_i][14]) * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   TOTAL      "); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][30] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][31] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][32] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][33] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][34] * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "                         M3             N1             N2             N3             C5"); b7_out();
			strcat(b7_ln, "   intrinsic  "); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][15] - z_fo[z_i][50]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][16] - z_fo[z_i][51]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][17] - z_fo[z_i][52]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][18] - z_fo[z_i][53]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][19] - z_fo[z_i][54]) * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   figuring   "); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][50] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][51] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][52] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][53] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][54] * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   induced    "); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][35] - z_fo[z_i][15]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][36] - z_fo[z_i][16]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][37] - z_fo[z_i][17]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][38] - z_fo[z_i][18]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][39] - z_fo[z_i][19]) * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   TOTAL      "); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][35] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][36] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][37] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][38] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][39] * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "                        Pi5             E5             B7"); b7_out();
			strcat(b7_ln, "   intrinsic  "); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][20] - z_fo[z_i][55]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][21] - z_fo[z_i][56]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][22] - z_fo[z_i][57]) * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   figuring   "); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][55] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][56] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][57] * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   induced    "); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][40] - z_fo[z_i][20]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][23] - z_fo[z_i][21]) * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*((z_fo[z_i][24] - z_fo[z_i][22]) * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
			strcat(b7_ln, "   TOTAL      "); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][40] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][23] * z_fnum)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_fo[z_i][24] * z_fnum)); strcat(b7_ln, b7_tmp); b7_out();
		}
		strcat(b7_ln, " "); b7_out();
		strcat(b7_ln, "Induced share of the fifth order carried by each surface."); b7_out();
		strcat(b7_ln, " "); b7_out();
		strcat(b7_ln, " Surf    induced/total   what it means"); b7_out();
		for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
		{
			z_uin = 0;
			z_utt = 0;
			for (z_uj = 10; z_uj <= 22; z_uj = z_uj + (1))
			{
				z_umt = z_fo[z_i][z_uj + 20];
				if (z_uj == 21) { z_umt = z_fo[z_i][23]; }
				if (z_uj == 22) { z_umt = z_fo[z_i][24]; }
				z_uin = z_uin + fabs(z_umt - z_fo[z_i][z_uj]);
				z_utt = z_utt + fabs(z_umt);
			}
			z_ufr = 0;
			if (z_utt > 0) { z_ufr = z_uin / z_utt; }
			strcpy(z_unot, "   mixed");
			if (z_ufr < 0.1)
			{
				strcpy(z_unot, "   its own doing - the fault, if there is one, is here");
			}
			if (z_ufr > 0.9)
			{
				strcpy(z_unot, "   mostly induced - look upstream");
			}
			if (z_ufr > 1.1)
			{
				strcpy(z_unot, "   induced exceeds the total - the two are cancelling here");
			}
			sprintf(b7_tmp, "%5.0f", 1.0*(z_i)); strcat(b7_ln, b7_tmp);
			sprintf(b7_tmp, "%12.4f", 1.0*(z_ufr)); strcat(b7_ln, b7_tmp); strcat(b7_ln, z_unot); b7_out();
		}
		strcat(b7_ln, " "); b7_out();
	}
	z_s_pmk();
	for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
	{
		for (z_j = 1; z_j <= 112; z_j = z_j + (1))
		{
			z_pc[z_i][z_j] = 0;
		}
	}
	return (0);
}

static int
z_part5()
{
	for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
	{
		if (z_vfm[z_i][6] == 1)
		{
			z_sfk = 0;
			z_nb = b7_ns[z_i - 1];
			z_na = b7_ns[z_i];
			if (fabs(z_na) < z_eps) { z_na = 1; }
			z_sfk = z_nb / z_na;
			z_conic = z_vfm[z_i][2];
			z_aterm = z_vfm[z_i][3];
			z_bterm = z_vfm[z_i][4];
			z_cterm = z_vfm[z_i][5];
			z_cv = z_vfm[z_i][1];
			z_cv2 = z_cv * z_cv;
			z_cv3 = z_cv2 * z_cv;
			z_c1 = 8 * z_aterm + z_conic * z_cv3;
			z_c2 = 12 * z_bterm + 0.75 * z_cv2 * (z_cv3 * z_conic * (z_conic + 2) - 2 * z_c1);
			z_tmp = z_cv3 * z_conic * (z_conic * z_conic + 3 * z_conic + 3) - 3 * z_c1;
			z_tmp = z_cv2 * (5 * z_cv2 * z_tmp - 12 * z_c2);
			z_tmp = (-6 * z_cv * z_c1 * z_c1 + z_tmp) / 8;
			z_c3 = 16 * z_cterm + z_tmp;
			z_f2s = z_efl * z_efl;
			z_f3s = z_f2s * z_efl;
			z_sfc1 = 0.5 * z_c1 * z_f3s;
			z_sfc2 = 0.5 * z_c2 * z_f3s * z_f2s;
			z_sfc3 = 0.5 * z_c3 * z_f3s * z_f2s * z_f2s;
			z_sfc0 = z_cv * z_efl;
			z_pcf[z_i][1] = z_sfc1;
			z_pcf[z_i][2] = z_sfc2;
			z_pcf[z_i][3] = z_sfc3;
			z_sa1 = z_sfc1;
			z_sa2 = z_sfc2;
			z_sa3 = z_sfc3;
			z_s_psurf();
			z_s_pcub3();
			for (z_j = 1; z_j <= 10; z_j = z_j + (1))
			{
				z_pc[z_i][z_j] = 16 * z_cub[1][z_j];
			}
			z_s_pcub4();
			for (z_j = 1; z_j <= 6; z_j = z_j + (1))
			{
				z_pc[z_i][20 + z_j] = 16 * z_cub[1][z_j];
			}
			z_ga = 7;
			z_s_pcubs();
			for (z_j = 1; z_j <= 10; z_j = z_j + (1))
			{
				z_pc[z_i][32 + z_j] = z_cub[1][z_j];
			}
			z_ga = 6;
			z_gb = 1;
			z_gc = 20;
			z_s_pmul();
			z_ga = 20;
			z_s_pcubs();
			for (z_j = 1; z_j <= 10; z_j = z_j + (1))
			{
				z_pc[z_i][42 + z_j] = z_cub[1][z_j];
			}
			z_ga = 6;
			z_gb = 8;
			z_gc = 20;
			z_s_pmul();
			z_ga = 20;
			z_s_pcubs();
			for (z_j = 1; z_j <= 10; z_j = z_j + (1))
			{
				z_pc[z_i][52 + z_j] = z_cub[1][z_j];
			}
			z_ga = 5;
			z_gb = 2;
			z_gc = 20;
			z_s_pmul();
			z_ga = 20;
			z_s_pcubs();
			for (z_j = 1; z_j <= 10; z_j = z_j + (1))
			{
				z_pc[z_i][62 + z_j] = z_cub[1][z_j];
			}
			z_ga = 8;
			z_gb = 1;
			z_gc = 21;
			z_s_pmul();
			for (z_j = 1; z_j <= 64; z_j = z_j + (1))
			{
				z_pw[22][z_j] = z_pw[21][z_j] + z_pw[9][z_j];
			}
			z_ga = 5;
			z_gb = 22;
			z_gc = 20;
			z_s_pmul();
			z_ga = 20;
			z_s_pcubs();
			for (z_j = 1; z_j <= 10; z_j = z_j + (1))
			{
				z_pc[z_i][72 + z_j] = z_cub[1][z_j];
			}
			z_ga = 2;
			z_s_pquad();
			for (z_j = 1; z_j <= 6; z_j = z_j + (1))
			{
				z_pc[z_i][82 + z_j] = z_cub[1][z_j];
			}
			z_ga = 22;
			z_s_pquad();
			for (z_j = 1; z_j <= 6; z_j = z_j + (1))
			{
				z_pc[z_i][88 + z_j] = z_cub[1][z_j];
			}
			z_sa1 = 0;
			z_sa2 = 0;
			z_sa3 = 0;
			z_s_psurf();
			z_s_pcub3();
			for (z_j = 1; z_j <= 10; z_j = z_j + (1))
			{
				z_pc[z_i][10 + z_j] = 16 * z_cub[1][z_j];
			}
			z_s_pcub4();
			for (z_j = 1; z_j <= 6; z_j = z_j + (1))
			{
				z_pc[z_i][26 + z_j] = 16 * z_cub[1][z_j];
			}
			z_ga = 2;
			z_s_pquad();
			for (z_j = 1; z_j <= 6; z_j = z_j + (1))
			{
				z_pc[z_i][94 + z_j] = z_cub[1][z_j];
			}
			z_ga = 8;
			z_gb = 1;
			z_gc = 21;
			z_s_pmul();
			for (z_j = 1; z_j <= 64; z_j = z_j + (1))
			{
				z_pw[22][z_j] = z_pw[21][z_j] + z_pw[9][z_j];
			}
			z_ga = 22;
			z_s_pquad();
			for (z_j = 1; z_j <= 6; z_j = z_j + (1))
			{
				z_pc[z_i][100 + z_j] = z_cub[1][z_j];
			}
		}
	}
	for (z_i = 1; z_i <= 4 * z_nsm + 14; z_i = z_i + (1))
	{
		for (z_j = 1; z_j <= 8; z_j = z_j + (1))
		{
			z_ai[z_i][z_j] = 0;
		}
	}
	z_nruns = 1;
	if (z_anyfig == 1) { z_nruns = 4; }
	z_flatbad = 0;
	for (z_grun = 1; z_grun <= z_nruns; z_grun = z_grun + (1))
	{
		z_gdual = 0;
		if (z_grun > 2) { z_gdual = 1; }
		z_gfig = 0;
		if (z_grun == 2) { z_gfig = 1; }
		if (z_grun == 4) { z_gfig = 1; }
		if (z_gfig == 1)
		{
			z_s_bridge();
		}
		z_s_tablei();
		z_s_tablei2();
	}
	if (z_flatbad == 1)
	{
		strcat(b7_ln, " "); b7_out();
		strcat(b7_ln, "DECLINED. A figured surface is flat and faces collimated light, so the"); b7_out();
		strcat(b7_ln, "marginal incidence is zero and the incidence ratio q is infinite. The"); b7_out();
		strcat(b7_ln, "finite coefficients arrive there only after terms carrying different powers"); b7_out();
		strcat(b7_ln, "of q cancel, which needs series arithmetic this macro does not have. Bend"); b7_out();
		strcat(b7_ln, "the surface and it is exact again. The third and fifth orders above are"); b7_out();
		strcat(b7_ln, "unaffected by this and stand."); b7_out();
		z_stop = 1; return (0);
	}
	if (z_dbg == 1)
	{
		strcat(b7_ln, " "); b7_out();
		strcat(b7_ln, "Table I entries for this lens, the unfigured pass. The entry numbers are"); b7_out();
		strcat(b7_ln, "Buchdahl's own, and BUCH7 prints the same table in the same order."); b7_out();
		for (z_j = 1; z_j <= 155; z_j = z_j + (1))
		{
			strcat(b7_ln, "t "); sprintf(b7_tmp, "%4.0f", 1.0*(z_j)); strcat(b7_ln, b7_tmp);
			for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
			{
				sprintf(b7_tmp, "%20.9e", 1.0*(z_tt[z_i + 1][z_j])); strcat(b7_ln, b7_tmp);
			}
			strcat(b7_ln, " "); b7_out();
		}
	}
	return (0);
}

static int
z_part6()
{
	for (z_k = 1; z_k <= 10; z_k = z_k + (1))
	{
		z_po[9][z_k] = 0;
		z_po[10][z_k] = 0;
	}
	if (z_anyfig == 0)
	{
		z_sqf = 2;
		for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
		{
			z_psb = 1 + z_i;
			z_pscar = z_tt[z_psb][6];
			z_s_pass();
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_po[9][z_k] = z_po[9][z_k] + z_po[1][z_k];
				z_po[10][z_k] = z_po[10][z_k] + z_po[2][z_k];
				z_pt[z_i][z_k] = z_po[1][z_k];
				z_pt[z_i][10 + z_k] = z_po[2][z_k];
			}
		}
	}
	else
	{
		z_tdg = z_nsm + 3;
		z_tddg = 3 * (z_nsm + 2) + 1;
		z_sqf = z_tdg + 1;
		for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
		{
			z_tdb = z_tdg + z_i;
			z_tdd = z_tddg + z_i;
			for (z_k = 1; z_k <= 9; z_k = z_k + (1))
			{
				z_sv[1][z_k] = z_tt[z_tdb][24 + z_k];
			}
			for (z_k = 1; z_k <= 20; z_k = z_k + (1))
			{
				z_sv[1][9 + z_k] = z_tt[z_tdb][100 + z_k];
			}
			z_sv[2][1] = z_tt[z_tdb][10];
			z_sv[2][2] = z_tt[z_tdb][13];
			z_sv[2][3] = z_tt[z_tdb][40];
			z_sv[2][4] = z_tt[z_tdb][38];
			z_sv[2][5] = z_tt[z_tdb][44];
			z_sv[2][6] = z_tt[z_tdb][50];
			z_sv[2][7] = z_tt[z_tdb][54];
			z_sv[2][8] = z_tt[z_tdb][59];
			z_sv[2][9] = z_tt[z_tdb][65];
			z_sv[2][10] = z_tt[z_tdb][45];
			z_sv[2][11] = z_tt[z_tdb][51];
			z_sv[2][12] = z_tt[z_tdb][55];
			z_sv[2][13] = z_tt[z_tdb][61];
			z_sv[2][14] = z_tt[z_tdb][66];
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_sv[3][z_k] = z_tt[z_tdb][120 + z_k];
			}
			z_fmb = z_tdb;
			z_fmd = z_tdd;
			z_fmc = 1;
			z_s_fam();
			z_tzb = z_tdb;
			z_s_tdzero();
			z_psb = z_tdb;
			z_pscar = z_rv[z_tdb][1];
			z_s_pass();
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_po[3][z_k] = z_po[1][z_k];
				z_po[4][z_k] = z_po[2][z_k];
			}
			z_fmc = 0;
			z_s_fam();
			z_tt[z_tdb][10] = z_rv[z_tdb][2];
			z_tt[z_tdb][13] = z_rv[z_tdb][4];
			z_tt[z_tdb][38] = z_rv[z_tdb][22] + z_rv[z_tdb][34];
			z_tt[z_tdb][44] = z_rv[z_tdb][23] + z_rv[z_tdb][35];
			z_tt[z_tdb][50] = z_rv[z_tdb][24] + z_rv[z_tdb][36];
			z_tt[z_tdb][54] = z_rv[z_tdb][25] + z_rv[z_tdb][37];
			z_tt[z_tdb][59] = z_rv[z_tdb][26] + z_rv[z_tdb][38];
			z_tt[z_tdb][65] = z_rv[z_tdb][27] + z_rv[z_tdb][39];
			z_tt[z_tdb][45] = z_rv[z_tdb][46] + z_rv[z_tdb][35];
			z_tt[z_tdb][51] = z_rv[z_tdb][47] + z_rv[z_tdb][36];
			z_tt[z_tdb][55] = z_rv[z_tdb][48] + z_rv[z_tdb][37];
			z_tt[z_tdb][61] = z_rv[z_tdb][49] + z_rv[z_tdb][38];
			z_tt[z_tdb][66] = z_rv[z_tdb][50] + z_rv[z_tdb][39];
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_tt[z_tdb][120 + z_k] = z_rv[z_tdb][55 + z_k];
			}
			z_tt[z_tdb][40] = z_tt[z_tdb][38] + 2 * z_tt[z_tdb][10] * z_tt[z_tdb][25];
			z_psb = z_tdb;
			z_pscar = z_tt[z_tdb][6];
			z_s_pass();
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_po[5][z_k] = z_po[1][z_k];
				z_po[6][z_k] = z_po[2][z_k];
			}
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_sv[4][z_k] = z_tt[z_tdb][120 + z_k];
			}
			z_sv[5][1] = z_tt[z_tdb][134];
			z_sv[5][2] = z_tt[z_tdb][136];
			z_sv[5][3] = z_tt[z_tdb][138];
			z_sv[5][4] = z_tt[z_tdb][140];
			z_sv[5][5] = z_tt[z_tdb][141];
			z_fmc = 1;
			z_s_fam();
			z_tt[z_tdb][10] = z_rv[z_tdb][3];
			z_tt[z_tdb][13] = z_rv[z_tdb][5];
			z_tt[z_tdb][38] = z_rv[z_tdb][28] - z_rv[z_tdb][34];
			z_tt[z_tdb][44] = z_rv[z_tdb][29] - z_rv[z_tdb][35];
			z_tt[z_tdb][50] = z_rv[z_tdb][30] - z_rv[z_tdb][36];
			z_tt[z_tdb][54] = z_rv[z_tdb][31] - z_rv[z_tdb][37];
			z_tt[z_tdb][59] = z_rv[z_tdb][32] - z_rv[z_tdb][38];
			z_tt[z_tdb][65] = z_rv[z_tdb][33] - z_rv[z_tdb][39];
			z_tt[z_tdb][45] = z_rv[z_tdb][51] - z_rv[z_tdb][35];
			z_tt[z_tdb][51] = z_rv[z_tdb][52] - z_rv[z_tdb][36];
			z_tt[z_tdb][55] = z_rv[z_tdb][53] - z_rv[z_tdb][37];
			z_tt[z_tdb][61] = z_rv[z_tdb][54] - z_rv[z_tdb][38];
			z_tt[z_tdb][66] = z_rv[z_tdb][55] - z_rv[z_tdb][39];
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_tt[z_tdb][120 + z_k] = z_rv[z_tdb][65 + z_k];
			}
			z_tt[z_tdb][40] = z_tt[z_tdb][38] + 2 * z_tt[z_tdb][10] * z_tt[z_tdb][25];
			z_psb = z_tdb;
			z_pscar = z_rv[z_tdb][1];
			z_s_pass();
			for (z_k = 1; z_k <= 10; z_k = z_k + (1))
			{
				z_po[9][z_k] = z_po[9][z_k] + z_po[5][z_k] + z_po[1][z_k] - z_po[3][z_k];
				z_po[10][z_k] = z_po[10][z_k] + z_po[6][z_k] + z_po[2][z_k] - z_po[4][z_k];
				z_pt[z_i][z_k] = z_po[5][z_k] + z_po[1][z_k] - z_po[3][z_k];
				z_pt[z_i][10 + z_k] = z_po[6][z_k] + z_po[2][z_k] - z_po[4][z_k];
			}
			if (z_dbg == 1)
			{
				strcat(b7_ln, " "); b7_out();
				strcat(b7_ln, "Surface "); sprintf(b7_tmp, "%3.0f", 1.0*(z_i)); strcat(b7_ln, b7_tmp); strcat(b7_ln, " - hat, then check less its residue:"); b7_out();
