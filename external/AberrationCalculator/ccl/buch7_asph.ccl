		strcat(b7_ln, "The ten tertiary totals and their barred partners, unconverted."); b7_out();
		strcat(b7_ln, "   T1  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][1])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  T2  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][2])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  T3  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][3])); strcat(b7_ln, b7_tmp); b7_out();
		strcat(b7_ln, "   T4  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][4])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  T5  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][5])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  T6  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][6])); strcat(b7_ln, b7_tmp); b7_out();
		strcat(b7_ln, "   T7  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][7])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  T8  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][8])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  T9  "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][9])); strcat(b7_ln, b7_tmp); b7_out();
		strcat(b7_ln, "   T10 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[9][10])); strcat(b7_ln, b7_tmp); b7_out();
		strcat(b7_ln, "   Tb1 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][1])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  Tb2 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][2])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  Tb3 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][3])); strcat(b7_ln, b7_tmp); b7_out();
		strcat(b7_ln, "   Tb4 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][4])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  Tb5 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][5])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  Tb6 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][6])); strcat(b7_ln, b7_tmp); b7_out();
		strcat(b7_ln, "   Tb7 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][7])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  Tb8 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][8])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  Tb9 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][9])); strcat(b7_ln, b7_tmp); b7_out();
		strcat(b7_ln, "   Tb10"); sprintf(b7_tmp, "%15.6e", 1.0*(z_po[10][10])); strcat(b7_ln, b7_tmp); b7_out();
	}
	z_vec4[1] = z_po[9][1];
	z_vec4[2] = z_po[10][1] + z_po[9][2] / 2;
	z_vec4[3] = z_po[9][2] / 2;
	z_vec4[4] = z_po[10][2] + z_po[9][3];
	z_vec4[5] = z_po[9][3];
	return (0);
}

static int
z_part7()
{
	z_vec4[6] = z_po[9][4];
	z_vec4[7] = z_po[10][3] + z_po[10][4] / 2 + z_po[9][5] / 2 + 3 * z_po[9][7] / 8;
	z_vec4[8] = (z_po[10][4] + z_po[9][5] + z_po[9][7]) / 2;
	z_vec4[9] = z_po[9][5] / 2 + z_po[9][7] / 4;
	z_vec4[10] = z_po[9][7] / 8;
	z_vec4[11] = z_po[10][5] + z_po[9][6];
	z_vec4[12] = z_po[10][7] + z_po[9][8];
	z_vec4[13] = z_po[9][6];
	z_vec4[14] = z_po[9][8];
	z_vec4[15] = z_po[10][6] + z_po[10][8] / 2 + z_po[9][9] / 2;
	z_vec4[16] = (z_po[10][8] + z_po[9][9]) / 2;
	z_vec4[17] = z_po[9][9] / 2;
	z_vec4[18] = z_po[10][9] + z_po[9][10];
	z_vec4[19] = z_po[9][10];
	z_vec4[20] = z_po[10][10];
	z_epr = z_vec2[2] + z_epp * z_vec2[501];
	z_um = -(z_epr / z_efl) / z_goe;
	if (z_finite == 1)
	{
		z_hobj = z_vec3[2] - z_objd * z_vec3[501];
		z_hmax = -z_hobj / z_objd;
	}
	else
	{
		z_hmax = fabs(z_vec3[501]);
	}
	if (fabs(z_hmax) < z_eps)
	{
		strcat(b7_ln, "The chief ray carries no field, so the field variable cannot be recovered."); b7_out();
		strcat(b7_ln, "Is the field zero?"); b7_out();
		z_stop = 1; return (0);
	}
	z_hmax = z_hmax * z_n0abs;
	z_vpk = z_rv[1 + z_nsm][20];
	if (z_anyfig == 1) { z_vpk = z_rv[z_tdg + z_nsm][20]; }
	if (fabs(z_vpk) < z_eps)
	{
		strcat(b7_ln, "The p ray leaves the last surface parallel to the axis - the system is"); b7_out();
		strcat(b7_ln, "afocal, and the seventh order cannot be put into transverse measure."); b7_out();
		z_stop = 1; return (0);
	}
	z_efac = z_efl / (z_nlsig * z_vpk);
	z_up2 = z_um * z_um;
	z_up3 = z_up2 * z_um;
	z_up4 = z_up3 * z_um;
	z_up5 = z_up4 * z_um;
	z_up6 = z_up5 * z_um;
	z_up7 = z_up6 * z_um;
	z_h2 = z_hmax * z_hmax;
	z_h3 = z_h2 * z_hmax;
	z_h4 = z_h3 * z_hmax;
	z_h5 = z_h4 * z_hmax;
	z_h6 = z_h5 * z_hmax;
	z_h7 = z_h6 * z_hmax;
	z_vec4[21] = z_efac * z_up7;
	z_vec4[22] = z_efac * z_up6 * z_hmax;
	z_vec4[23] = z_vec4[22];
	z_vec4[24] = z_efac * z_up5 * z_h2;
	z_vec4[25] = z_vec4[24];
	z_vec4[26] = z_vec4[24];
	z_vec4[27] = z_efac * z_up4 * z_h3;
	z_vec4[28] = z_vec4[27];
	z_vec4[29] = z_vec4[27];
	z_vec4[30] = z_vec4[27];
	z_vec4[31] = z_efac * z_up3 * z_h4;
	z_vec4[32] = z_vec4[31];
	z_vec4[33] = z_vec4[31];
	z_vec4[34] = z_vec4[31];
	z_vec4[35] = z_efac * z_up2 * z_h5;
	z_vec4[36] = z_vec4[35];
	z_vec4[37] = z_vec4[35];
	z_vec4[38] = z_efac * z_um * z_h6;
	z_vec4[39] = z_vec4[38];
	z_vec4[40] = z_efac * z_h7;
	for (z_k = 1; z_k <= 20; z_k = z_k + (1))
	{
		z_vec4[z_k] = z_vec4[z_k] * z_vec4[20 + z_k];
	}
	z_tau1s = z_vec4[1];
	z_vec4[1] = z_sb7 * z_fnum;
	strcat(b7_ln, " "); b7_out();
	strcat(b7_ln, "Seventh order, system totals, transverse measure - Buchdahl's tau."); b7_out();
	strcat(b7_ln, " "); b7_out();
	strcat(b7_ln, "   tau1 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[1])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau2 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[2])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau3 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[3])); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   tau4 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[4])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau5 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[5])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau6 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[6])); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   tau7 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[7])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau8 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[8])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau9 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[9])); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   tau10"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[10])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau11"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[11])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau12"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[12])); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   tau13"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[13])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau14"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[14])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau15"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[15])); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   tau16"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[16])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau17"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[17])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau18"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[18])); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "   tau19"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[19])); strcat(b7_ln, b7_tmp); strcat(b7_ln, "  tau20"); sprintf(b7_tmp, "%15.6e", 1.0*(z_vec4[20])); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, " "); b7_out();
	strcat(b7_ln, "tau1 above is B7, reached through the fifth-order working. The scheme reaches"); b7_out();
	strcat(b7_ln, "it a second time through Table I, and gets"); b7_out();
	strcat(b7_ln, "   tau1 "); sprintf(b7_tmp, "%15.6e", 1.0*(z_tau1s)); strcat(b7_ln, b7_tmp); b7_out();
	strcat(b7_ln, "On a lens of spheres the two agree exactly; on a figured lens they agree to"); b7_out();
	strcat(b7_ln, "the accuracy of the arrangement, and a large disagreement is a warning."); b7_out();
	strcat(b7_ln, " "); b7_out();
	if (z_srf == 1)
	{
		for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
		{
			z_tw[z_i][1] = z_pt[z_i][1];
			z_tw[z_i][2] = z_pt[z_i][11] + z_pt[z_i][2] / 2;
			z_tw[z_i][3] = z_pt[z_i][2] / 2;
			z_tw[z_i][4] = z_pt[z_i][12] + z_pt[z_i][3];
			z_tw[z_i][5] = z_pt[z_i][3];
			z_tw[z_i][6] = z_pt[z_i][4];
			z_tw[z_i][7] = z_pt[z_i][13] + z_pt[z_i][14] / 2 + z_pt[z_i][5] / 2 + 3 * z_pt[z_i][7] / 8;
			z_tw[z_i][8] = (z_pt[z_i][14] + z_pt[z_i][5] + z_pt[z_i][7]) / 2;
			z_tw[z_i][9] = z_pt[z_i][5] / 2 + z_pt[z_i][7] / 4;
			z_tw[z_i][10] = z_pt[z_i][7] / 8;
			z_tw[z_i][11] = z_pt[z_i][15] + z_pt[z_i][6];
			z_tw[z_i][12] = z_pt[z_i][17] + z_pt[z_i][8];
			z_tw[z_i][13] = z_pt[z_i][6];
			z_tw[z_i][14] = z_pt[z_i][8];
			z_tw[z_i][15] = z_pt[z_i][16] + z_pt[z_i][18] / 2 + z_pt[z_i][9] / 2;
			z_tw[z_i][16] = (z_pt[z_i][18] + z_pt[z_i][9]) / 2;
			z_tw[z_i][17] = z_pt[z_i][9] / 2;
			z_tw[z_i][18] = z_pt[z_i][19] + z_pt[z_i][10];
			z_tw[z_i][19] = z_pt[z_i][10];
			z_tw[z_i][20] = z_pt[z_i][20];
			for (z_k = 1; z_k <= 20; z_k = z_k + (1))
			{
				z_tw[z_i][z_k] = z_tw[z_i][z_k] * z_vec4[20 + z_k];
			}
			z_tw[z_i][1] = z_fo[z_i][24] * z_fnum;
		}
		strcat(b7_ln, " "); b7_out();
		strcat(b7_ln, "==============================================================================="); b7_out();
		strcat(b7_ln, "SEVENTH ORDER, SURFACE BY SURFACE - the twenty tau, transverse measure."); b7_out();
		strcat(b7_ln, "==============================================================================="); b7_out();
		for (z_kg = 0; z_kg <= 3; z_kg = z_kg + (1))
		{
			z_k1 = 5 * z_kg + 1;
			strcat(b7_ln, " "); b7_out();
			if (z_kg == 0)
			{
				strcat(b7_ln, " Surf           tau1           tau2           tau3           tau4           tau5"); b7_out();
			}
			if (z_kg == 1)
			{
				strcat(b7_ln, " Surf           tau6           tau7           tau8           tau9          tau10"); b7_out();
			}
			if (z_kg == 2)
			{
				strcat(b7_ln, " Surf          tau11          tau12          tau13          tau14          tau15"); b7_out();
			}
			if (z_kg == 3)
			{
				strcat(b7_ln, " Surf          tau16          tau17          tau18          tau19          tau20"); b7_out();
			}
			z_ws1 = 0;
			z_ws2 = 0;
			z_ws3 = 0;
			z_ws4 = 0;
			z_ws5 = 0;
			for (z_i = 1; z_i <= z_nsm; z_i = z_i + (1))
			{
				z_ws1 = z_ws1 + z_tw[z_i][z_k1];
				z_ws2 = z_ws2 + z_tw[z_i][z_k1 + 1];
				z_ws3 = z_ws3 + z_tw[z_i][z_k1 + 2];
				z_ws4 = z_ws4 + z_tw[z_i][z_k1 + 3];
				z_ws5 = z_ws5 + z_tw[z_i][z_k1 + 4];
				sprintf(b7_tmp, "%5.0f", 1.0*(z_i)); strcat(b7_ln, b7_tmp);
				sprintf(b7_tmp, "%15.6e", 1.0*(z_tw[z_i][z_k1])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_tw[z_i][z_k1 + 1])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_tw[z_i][z_k1 + 2])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_tw[z_i][z_k1 + 3])); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_tw[z_i][z_k1 + 4])); strcat(b7_ln, b7_tmp); b7_out();
			}
			strcat(b7_ln, "  SUM");
			sprintf(b7_tmp, "%15.6e", 1.0*(z_ws1)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_ws2)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_ws3)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_ws4)); strcat(b7_ln, b7_tmp); sprintf(b7_tmp, "%15.6e", 1.0*(z_ws5)); strcat(b7_ln, b7_tmp); b7_out();
		}
		strcat(b7_ln, " "); b7_out();
		strcat(b7_ln, "The SUM rows are the twenty totals printed above. They are computed here by a"); b7_out();
		strcat(b7_ln, "different route - summed after conversion rather than before it - so a"); b7_out();
		strcat(b7_ln, "disagreement between them is a fault in this macro and not in your lens."); b7_out();
		strcat(b7_ln, " "); b7_out();
	}
	return (0);
}

static int
z_main()
{
	z_part4();
	z_part5();
	if (z_stop) return (0);
	z_part6();
	z_part7();
	if (z_stop) return (0);
	return (0);
}

static int
b7_run(int k_srfarg, int k_wavarg)
{
	int    k_i, k_j, k_uj, k_wvn, k_badtyp, k_infobj, k_anyfig, k_anyr2, k_nmir;
	double k_sgn, k_t0, k_epup, k_efl, k_epd, k_uobj, k_yobj, k_a_st, k_b_st, k_yA, k_lag, k_n0, k_n0abs;
	double k_pupf, k_nlast, k_fnum, k_objd, k_iota, k_fld, k_epp, k_p0;
	double k_vcv, k_vkk, k_va2, k_va4, k_va6, k_va8, k_vc2, k_vc3, k_vc5, k_vc7, k_vk1, k_vt2, k_vt3, k_vt4, k_vv, k_vv2, k_vv3, k_vv5, k_vv7;


	b7_nsm = ims - 1;
	if (b7_nsm < 1)
	{
		sprintf(b7_ln, "buch7_asph needs at least one optical surface between object and image.");
		b7_out();
		return (0);
	}
	if (ims + 1 > B7_MAXS)
	{
		sprintf(b7_ln, "buch7_asph holds at most %d surfaces.", B7_MAXS - 2);
		b7_out();
		return (0);
	}
	if (k_wavarg > 0)
		k_wvn = k_wavarg;
	else
		k_wvn = +wav + 1;

	// ---- surface types. Declined by name rather than by reading data that are not a
	// conic and even terms. AG cannot reach the seventh order and is said to be dropped.
	k_badtyp = 0;
	for (k_i = 1; k_i <= b7_nsm; k_i++)
	{
		if (!(srftyp[k_i] == 0 || srftyp[k_i] == 1 || srftyp[k_i] == 4 || srftyp[k_i] == 5))
		{
			sprintf(b7_ln, "Surface %d is of type %d (OSLO srftyp), not a plane, sphere, conic or standard asphere.", k_i, srftyp[k_i]);
			b7_out();
			k_badtyp = 1;
		}
		else if (srftyp[k_i] == 5 && asp[k_i] != 0)
		{
			sprintf(b7_ln, "Surface %d carries a general polynomial asphere (OSLO asp %d), not the standard AD..AG.", k_i, asp[k_i]);
			b7_out();
			k_badtyp = 1;
		}
		if (fabs(ag[k_i]) > 0.0)
		{
			sprintf(b7_ln, "NOTE: surface %d carries AG, the r^10 term, which cannot reach the seventh order and takes no part.", k_i);
			b7_out();
		}
	}
	if (k_badtyp)
	{
		sprintf(b7_ln, "buch7_asph carries plane, spherical, conic and standard aspheric surfaces. On any other");
		b7_out();
		sprintf(b7_ln, "type the surface data mean something other than a conic and even terms, so it declines.");
		b7_out();
		return (0);
	}

	// ---- the index after each surface, signed by the mirror count: after an odd number of
	// reflections light runs toward -z, and a negated index reproduces that exactly.
	k_sgn = 1.0;
	k_nmir = 0;
	b7_ns[0] = fabs(rn[0][k_wvn]);
	for (k_i = 1; k_i <= b7_nsm; k_i++)
	{
		if (gltyp[k_i] == 4)
		{
			k_sgn = -k_sgn;
			k_nmir++;
			b7_ns[k_i] = k_sgn*fabs(b7_ns[k_i - 1]);
		}
		else
			b7_ns[k_i] = k_sgn*fabs(rn[k_i][k_wvn]);
	}

	// ---- the two paraxial rays, exactly as ParaxialTrace launches them
	k_infobj = 0;
	k_t0 = fabs(th[0]);
	if (k_t0 >= 1e10)
	{
		k_infobj = 1;
		k_t0 = 0.0;
	}

	// the entrance pupil, from two basis rays: where the ray that crosses the axis at the
	// stop came from, measured from surface 1
	if (ast < 1 || ast > b7_nsm)
	{
		sprintf(b7_ln, "No aperture stop between the object and the image.");
		b7_out();
		return (0);
	}
	b7_prop(1.0, 0.0);
	k_a_st = b7_ya[ast];
	k_yA = b7_ns[b7_nsm]*b7_ua[b7_nsm];
	b7_prop(0.0, 1.0);
	k_b_st = b7_ya[ast];
	if (fabs(k_a_st) > 1e-15)
		k_epup = k_b_st/k_a_st;
	else
		k_epup = 0.0;
	if (fabs(k_yA) < 1e-15)
	{
		sprintf(b7_ln, "The system has no focal length; an afocal system is not handled.");
		b7_out();
		return (0);
	}
	k_efl = -b7_ns[0]/k_yA;

	// the marginal ray: from the axial object point to the edge of the entrance pupil
	k_epd = 2.0*(+ebr);
	if (k_infobj)
	{
		k_yobj = 0.5*k_epd;
		k_uobj = 0.0;
	}
	else
	{
		k_uobj = 0.5*k_epd/(k_t0 + k_epup);
		k_yobj = k_uobj*k_t0;
	}
	b7_prop(k_yobj, k_uobj);
	for (k_i = 0; k_i <= b7_nsm; k_i++)
	{
		b7_ym[k_i] = b7_ya[k_i];
		b7_um[k_i] = b7_ua[k_i];
	}

	// the chief ray: from the edge of the field through the centre of the entrance pupil.
	// At infinity the field is ANG; at a finite object it is the object height OBH.
	if (k_infobj)
	{
		k_fld = +ang;
		k_uobj = tan(k_fld);
		k_yobj = -k_uobj*k_epup;
	}
	else
	{
		k_fld = fabs(+obh);
		k_uobj = -k_fld/(k_t0 + k_epup);
		k_yobj = k_fld + k_uobj*k_t0;
	}
	b7_prop(k_yobj, k_uobj);
	for (k_i = 0; k_i <= b7_nsm; k_i++)
	{
		b7_yc[k_i] = b7_ya[k_i];
		b7_uc[k_i] = b7_ua[k_i];
	}

	k_n0 = b7_ns[0];
	k_lag = k_n0*(b7_uc[0]*b7_ym[1] - b7_um[0]*b7_yc[1]);
	k_n0abs = fabs(k_n0);
	if (fabs(k_lag) < 1e-10)
	{
		sprintf(b7_ln, "The Lagrange invariant is zero. Is the field zero, or the aperture?");
		b7_out();
		return (0);
	}

	k_epp = k_epup;
	k_p0 = k_epp/k_efl;
	k_pupf = b7_um[b7_nsm];
	k_nlast = fabs(b7_ns[b7_nsm]);
	k_fnum = -0.5/k_nlast/k_pupf;
	k_objd = th[0];
	k_iota = 0.0;
	if (!k_infobj)
		k_iota = -k_efl/k_objd;

	// ---- the vertex form. OSLO's standard asphere has no r^2 term, so the curvature and
	// conic are the surface's own; the r^2 fold of the macro is kept for a surface that
	// would carry one, and is never reached here.
	k_anyfig = 0;
	k_anyr2 = 0;
	for (k_i = 1; k_i <= b7_nsm; k_i++)
	{
		k_vcv = cv[k_i];
		k_vkk = cc[k_i];
		k_va2 = 0.0;
		k_va4 = ad[k_i];
		k_va6 = ae[k_i];
		k_va8 = af[k_i];
		if (fabs(k_va2) > 0.0)
		{
			k_anyr2 = 1;
			k_vc2 = k_vcv*k_vcv;
			k_vc3 = k_vc2*k_vcv;
			k_vc5 = k_vc3*k_vc2;
			k_vc7 = k_vc5*k_vc2;
			k_vk1 = 1.0 + k_vkk;
			k_vt2 = k_vk1*k_vc3/8.0 + k_va4;
			k_vt3 = k_vk1*k_vk1*k_vc5/16.0 + k_va6;
			k_vt4 = 5.0*k_vk1*k_vk1*k_vk1*k_vc7/128.0 + k_va8;
			k_vv = k_vcv + 2.0*k_va2;
			k_vv2 = k_vv*k_vv;
			k_vv3 = k_vv2*k_vv;
			k_vv5 = k_vv3*k_vv2;
			k_vv7 = k_vv5*k_vv2;
			b7_vfm[k_i][1] = k_vv;
			b7_vfm[k_i][2] = 0.0;
			b7_vfm[k_i][3] = k_vt2 - k_vv3/8.0;
			b7_vfm[k_i][4] = k_vt3 - k_vv5/16.0;
			b7_vfm[k_i][5] = k_vt4 - 5.0*k_vv7/128.0;
		}
		else
		{
			b7_vfm[k_i][1] = k_vcv;
			b7_vfm[k_i][2] = k_vkk;
			b7_vfm[k_i][3] = k_va4;
			b7_vfm[k_i][4] = k_va6;
			b7_vfm[k_i][5] = k_va8;
		}
		b7_vfm[k_i][6] = 0.0;
		if (fabs(b7_vfm[k_i][2]) > 1e-14 || b7_vfm[k_i][3] != 0.0 || b7_vfm[k_i][4] != 0.0 || b7_vfm[k_i][5] != 0.0)
		{
			b7_vfm[k_i][6] = 1.0;
			k_anyfig = 1;
		}
	}

	sprintf(b7_ln, "BUCH7_ASPH (OSLO) - Buchdahl coefficients, conics and even aspheres carried");
	b7_out();
	sprintf(b7_ln, "Wavelength             %d (%.6f um)", k_wvn, wv[k_wvn]);
	b7_out();
	sprintf(b7_ln, "Effective focal length %.6f", k_efl);
	b7_out();
	sprintf(b7_ln, "F/number               %.6f", k_fnum);
	b7_out();
	sprintf(b7_ln, "Lagrange invariant     %.10g", k_lag);
	b7_out();
	sprintf(b7_ln, "Entrance pupil         %.6f from surface 1, radius %.6f", k_epp, 0.5*k_epd);
	b7_out();
	sprintf(b7_ln, "Buchdahl p             %.6f", k_p0);
	b7_out();
	if (k_infobj)
	{
		sprintf(b7_ln, "Object                 at infinity, field angle %.6f deg", k_fld*180.0/pi);
		b7_out();
	}
	else
	{
		sprintf(b7_ln, "Object distance        %.6f, object height %.6f", k_objd, k_fld);
		b7_out();
		sprintf(b7_ln, "Buchdahl iota          %.6f", k_iota);
		b7_out();
	}
	if (k_nmir > 0)
	{
		sprintf(b7_ln, "Reflections            %d", k_nmir);
		b7_out();
	}
	// A lens with no field: OSLO traces its chief ray at a slope of 1e-6 instead. B, B5 and
	// B7 do not depend on the field and are right; everything else is for that made-up field.
	if (fabs(k_uobj) < 1e-5)
	{
		sprintf(b7_ln, "WARNING: the field is OSLO's minimum (chief-ray slope %.1e), not a field of", k_uobj);
		b7_out();
		sprintf(b7_ln, "this lens. Only B, B5 and B7 mean anything; every field-dependent coefficient");
		b7_out();
		sprintf(b7_ln, "below is for that minimum field, and is zero for the lens itself.");
		b7_out();
	}
	if (k_anyfig == 0)
	{
		sprintf(b7_ln, "Nothing is figured: every figuring row below is zero.");
		b7_out();
	}
	sprintf(b7_ln, " ");
	b7_out();

	// ---- the paraxial rays, so they can be set beside OSLO's own (pxt all)
	sprintf(b7_ln, "Paraxial rays (axial: height, slope after; chief: height, slope after)");
	b7_out();
	sprintf(b7_ln, " Srf            PY             PU            PYC            PUC        index after");
	b7_out();
	for (k_i = 0; k_i <= b7_nsm; k_i++)
	{
		sprintf(b7_ln, "%4d %14.8f %14.8f %14.8f %14.8f %14.8f", k_i, b7_ym[k_i], b7_um[k_i], b7_yc[k_i], b7_uc[k_i], b7_ns[k_i]);
		b7_out();
	}
	sprintf(b7_ln, " ");
	b7_out();

	// ==================================================================================
	// Hand over to the macro's own arithmetic, translated statement for statement.
	// ==================================================================================
	z_zero();
	z_nsm = b7_nsm;
	z_eps = 1e-10;
	z_efl = k_efl;
	z_epp = k_epp;
	z_lag = k_lag;
	z_n0abs = k_n0abs;
	if (z_n0abs < z_eps)
		z_n0abs = 1.0;
	z_fnum = k_fnum;
	z_nlsig = k_nlast;
	z_objd = k_objd;
	z_finite = 1 - k_infobj;
	z_iota = k_iota;
	z_goe = 1.0 - k_p0*k_iota;
	if (fabs(z_goe) < 1e-12)
		z_goe = 1.0;
	z_stopp = k_p0;
	z_anyfig = k_anyfig;
	z_srf = k_srfarg;
	z_chk = 0;
	z_dbg = 0;
	for (k_i = 0; k_i <= b7_nsm; k_i++)
	{
		z_vec2[k_i + 1] = b7_ym[k_i];
		z_vec2[501 + k_i] = b7_um[k_i];
		z_vec3[k_i + 1] = b7_yc[k_i];
		z_vec3[501 + k_i] = b7_uc[k_i];
	}
	for (k_i = 1; k_i <= b7_nsm; k_i++)
		for (k_j = 1; k_j <= 6; k_j++)
			z_vfm[k_i][k_j] = b7_vfm[k_i][k_j];
	strcpy(b7_ln, "");
	z_stop = 0;
	z_main();

	sprintf(b7_ln, " ");
	b7_out();
	sprintf(b7_ln, "AberrationCalculator reads this lens file and computes the same coefficients in its C#;");
	b7_out();
	sprintf(b7_ln, "run it on the .len (buchdahl or surface_breakdown) and every number above must agree.");
	b7_out();
	return (0);
}

cmd
buch7_asph(int b7_srfarg, int b7_wavarg, int b7_filearg)
{
	b7_wf = 0;
	if (b7_filearg)
	{
		b7_fh = fopen(B7_REPORT, "at");
		if (b7_fh > 0)
			b7_wf = 1;
		else
			printf("buch7_asph: cannot write %s; carrying on without the report file.\n", B7_REPORT);
	}
	b7_run(b7_srfarg, b7_wavarg);
	if (b7_wf)
	{
		fclose(b7_fh);
		b7_wf = 0;
		printf("Report written to %s\n", B7_REPORT);
	}
}
