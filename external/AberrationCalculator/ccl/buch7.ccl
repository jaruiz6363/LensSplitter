// ---- generated: the macro's body from stage A on ----
static int    s7_stop;

static int
s7_part1()
{
	strcat(bs_ln, "Third order, per surface, unconverted - multiply by the F/number above to"); bs_out();
	strcat(bs_ln, "get a transverse aberration in lens units, which is done for the totals."); bs_out();
	strcat(bs_ln, " "); bs_out();
	strcat(bs_ln, " Surf              B              F              C             Pi              E"); bs_out();
	s7_sumb = 0;
	s7_sumf = 0;
	s7_sumc = 0;
	s7_sump = 0;
	s7_sume = 0;
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		s7_cv = cv[s7_i];
		s7_nb = bs_ns[s7_i - 1];
		s7_na = bs_ns[s7_i];
		if (fabs(s7_na) < s7_eps) { s7_na = 1; }
		s7_kk = s7_nb / s7_na;
		s7_km1 = s7_kk - 1;
		s7_py = s7_vec2[s7_i + 1];
		s7_pu = s7_vec2[500 + s7_i];
		s7_pup = s7_vec2[501 + s7_i];
		s7_pyc = s7_vec3[s7_i + 1];
		s7_puc = s7_vec3[500 + s7_i];
		s7_pucp = s7_vec3[501 + s7_i];
		s7_pai = s7_cv * s7_py + s7_pu;
		s7_paic = s7_cv * s7_pyc + s7_puc;
		s7_pz = s7_cv * s7_km1 * s7_lag * s7_lag / s7_nb;
		s7_sfm = s7_nb * s7_km1 * s7_py * (s7_pai + s7_pup);
		s7_sfc = s7_nb * s7_km1 * s7_pyc * (s7_paic + s7_pucp);
		s7_ba = s7_sfm * s7_pai * s7_pai;
		s7_fa = s7_sfm * s7_pai * s7_paic;
		s7_ca = s7_sfm * s7_paic * s7_paic;
		s7_fb = s7_sfc * s7_pai * s7_paic;
		s7_ea = s7_fb + s7_lag * s7_km1 * s7_paic * (s7_pucp + s7_puc);
		s7_bb = s7_sfc * s7_paic * s7_paic;
		s7_cb = s7_sfc * s7_pai * s7_pai;
		s7_eb = s7_fa - s7_lag * s7_km1 * s7_pai * (s7_pup + s7_pu);
		s7_b = (s7_i - 1) * 160;
		s7_vec4[s7_b + 1] = s7_ba;
		s7_vec4[s7_b + 2] = s7_fa;
		s7_vec4[s7_b + 3] = s7_ca;
		s7_vec4[s7_b + 4] = s7_pz;
		s7_vec4[s7_b + 5] = s7_ea;
		s7_vec4[s7_b + 6] = s7_bb;
		s7_vec4[s7_b + 7] = s7_fb;
		s7_vec4[s7_b + 8] = s7_cb;
		s7_vec4[s7_b + 9] = s7_eb;
		s7_paip = s7_pai * s7_kk;
		s7_paicp = s7_paic * s7_kk;
		s7_w = (s7_pai * s7_pai + s7_paip * s7_paip + s7_pup * s7_pup - 3 * s7_pu * s7_pu) / 8;
		s7_x73 = 3 * s7_pai * s7_paip + 2 * s7_pup * s7_pup - 3 * s7_pu * s7_pu;
		s7_x74 = 3 * s7_pai * s7_paicp + 2 * s7_pup * s7_pucp - 3 * s7_pu * s7_puc;
		s7_x75 = 3 * s7_paic * s7_paicp + 2 * s7_pucp * s7_pucp - 3 * s7_puc * s7_puc;
		s7_x76 = s7_pai * (3 * s7_pu - s7_pup);
		s7_x77 = s7_paic * (2 * s7_pu - s7_pup) + s7_pai * s7_puc;
		s7_x78 = s7_paic * (3 * s7_puc - s7_pucp);
		s7_x42 = s7_pyc * s7_pai * (s7_paic - s7_puc) + s7_py * s7_paic * (s7_pucp + s7_puc);
		s7_x82 = s7_pyc * s7_pu * (s7_paic - s7_puc) - s7_py * s7_paicp * (s7_pucp + s7_puc);
		s7_x42b = s7_py * s7_paic * (s7_pai - s7_pu) + s7_pyc * s7_pai * (s7_pup + s7_pu);
		s7_x82b = s7_py * s7_puc * (s7_pai - s7_pu) - s7_pyc * s7_paip * (s7_pup + s7_pu);
		s7_q1p = 3 * s7_w * s7_sfm * s7_pai;
		s7_q2p = s7_sfm * (s7_paic * s7_x73 + s7_pai * s7_x74 - s7_pucp * s7_x76 - s7_pup * s7_x77) / 4;
		s7_q3p = s7_nb * s7_km1 * (s7_x42 * s7_x73 + s7_x76 * s7_x82 + s7_py * (s7_pai + s7_pup) * (s7_pai * s7_x75 - s7_pup * s7_x78)) / 4;
		s7_q4p = s7_sfm * (s7_paic * s7_x74 - s7_pucp * s7_x77);
		s7_q5p = s7_nb * s7_km1 * (s7_x42 * s7_x74 + s7_x77 * s7_x82 + s7_py * (s7_pai + s7_pup) * (s7_paic * s7_x75 - s7_pucp * s7_x78)) / 4;
		s7_q6p = s7_nb * s7_km1 * (s7_x42 * s7_x75 + s7_x78 * s7_x82) / 4;
		s7_q1q = s7_nb * s7_km1 * (s7_x42b * s7_x73 + s7_x76 * s7_x82b) / 4;
		s7_t1p = 10 * s7_w * s7_w + s7_sfm * s7_pai * s7_cv * (2 * s7_pup - 5 * s7_pu) / s7_nb / 8;
		s7_ib5 = s7_pai * s7_q1p;
		s7_if1 = s7_paic * s7_q1p + s7_pai * s7_q2p;
		s7_if2 = s7_pai * s7_q2p;
		s7_im1 = 2 * s7_paic * s7_q2p;
		s7_im2 = s7_pai * s7_q3p;
		s7_im3 = s7_pai * s7_q4p;
		s7_in1 = s7_paic * s7_q3p;
		s7_in2 = s7_paic * s7_q4p + 2 * s7_pai * s7_q5p;
		s7_in3 = s7_pai * s7_q5p;
		s7_ic5 = 0.5 * s7_paic * s7_q5p;
		s7_ip5 = s7_pai * s7_q6p - 0.5 * s7_paic * s7_q5p;
		s7_ie5 = s7_paic * s7_q6p;
		s7_ie5b = s7_pai * s7_q1q;
		s7_ib7 = s7_ba * s7_t1p;
		s7_vec4[s7_b + 10] = s7_ib5;
		s7_vec4[s7_b + 11] = s7_if1;
		s7_vec4[s7_b + 12] = s7_if2;
		s7_vec4[s7_b + 13] = s7_im1;
		s7_vec4[s7_b + 14] = s7_im2;
		s7_vec4[s7_b + 15] = s7_im3;
		s7_vec4[s7_b + 16] = s7_in1;
		s7_vec4[s7_b + 17] = s7_in2;
		s7_vec4[s7_b + 18] = s7_in3;
		s7_vec4[s7_b + 19] = s7_ic5;
		s7_vec4[s7_b + 20] = s7_ip5;
		s7_vec4[s7_b + 21] = s7_ie5;
		s7_vec4[s7_b + 22] = s7_ib7;
		s7_vec4[s7_b + 23] = s7_ie5b;
		s7_sumb = s7_sumb + s7_ba;
		s7_sumf = s7_sumf + s7_fa;
		s7_sumc = s7_sumc + s7_ca;
		s7_sump = s7_sump + s7_pz;
		s7_sume = s7_sume + s7_ea;
		sprintf(bs_tmp, "%5.0f", 1.0*(s7_i)); strcat(bs_ln, bs_tmp);
		sprintf(bs_tmp, "%15.6e", 1.0*(s7_ba)); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_fa)); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_ca)); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_pz)); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_ea)); strcat(bs_ln, bs_tmp); bs_out();
	}
	strcat(bs_ln, " "); bs_out();
	strcat(bs_ln, "  SUM");
	sprintf(bs_tmp, "%15.6e", 1.0*(s7_sumb)); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sumf)); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sumc)); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sump)); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sume)); strcat(bs_ln, bs_tmp); bs_out();
	s7_accb = 0;
	s7_accf = 0;
	s7_accc = 0;
	s7_acce = 0;
	s7_accpi = 0;
	s7_accbb = 0;
	s7_accfb = 0;
	s7_acccb = 0;
	s7_acceb = 0;
	s7_accb5 = 0;
	s7_acce5b = 0;
	return (0);
}

static int
s7_part2()
{
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		s7_b = (s7_i - 1) * 160;
		s7_ba = s7_vec4[s7_b + 1];
		s7_fa = s7_vec4[s7_b + 2];
		s7_ca = s7_vec4[s7_b + 3];
		s7_pz = s7_vec4[s7_b + 4];
		s7_ea = s7_vec4[s7_b + 5];
		s7_bb = s7_vec4[s7_b + 6];
		s7_fb = s7_vec4[s7_b + 7];
		s7_cb = s7_vec4[s7_b + 8];
		s7_eb = s7_vec4[s7_b + 9];
		s7_ib5 = s7_vec4[s7_b + 10];
		s7_if1 = s7_vec4[s7_b + 11];
		s7_if2 = s7_vec4[s7_b + 12];
		s7_im1 = s7_vec4[s7_b + 13];
		s7_im2 = s7_vec4[s7_b + 14];
		s7_im3 = s7_vec4[s7_b + 15];
		s7_in1 = s7_vec4[s7_b + 16];
		s7_in2 = s7_vec4[s7_b + 17];
		s7_in3 = s7_vec4[s7_b + 18];
		s7_ic5 = s7_vec4[s7_b + 19];
		s7_ip5 = s7_vec4[s7_b + 20];
		s7_ie5 = s7_vec4[s7_b + 21];
		s7_ib7 = s7_vec4[s7_b + 22];
		s7_ie5b = s7_vec4[s7_b + 23];
		s7_z = 0.5 * s7_accb * s7_accb * (s7_pz + 3 * s7_ca) / s7_lag;
		s7_z = s7_z + 3 * (s7_accb5 - s7_accb * s7_acceb / s7_lag) * s7_fa;
		s7_z = s7_z + 3 * (0.5 * s7_acceb * s7_acceb / s7_lag - s7_acce5b) * s7_ba;
		s7_z = (s7_z + s7_accb * (s7_if1 + s7_if2) - 5 * s7_acceb * s7_ib5) / (2 * s7_lag);
		s7_tb7 = s7_ib7 + s7_z;
		s7_tb5 = s7_ib5 + 1.5 * (s7_accb * s7_fa - s7_acceb * s7_ba) / s7_lag;
		s7_z = s7_accb * (s7_pz + 4 * s7_ca) + (5 * s7_accf - 4 * s7_acceb) * s7_fa;
		s7_z = s7_z - (2 * s7_accpi + 5 * s7_acccb) * s7_ba;
		s7_tf1 = s7_if1 + s7_z / (2 * s7_lag);
		s7_z = s7_accb * (s7_pz + 2 * s7_ca) + 2 * (2 * s7_accf - s7_acceb) * s7_fa;
		s7_z = s7_z - (s7_accpi + 4 * s7_acccb) * s7_ba;
		s7_tf2 = s7_if2 + s7_z / (2 * s7_lag);
		s7_z = s7_accb * s7_ea + (4 * s7_accf - s7_acceb) * s7_ca - s7_accfb * s7_ba;
		s7_z = s7_z + (s7_accc - 4 * s7_acccb - 2 * s7_accpi) * s7_fa;
		s7_tm1 = s7_im1 + s7_z / s7_lag;
		s7_z = s7_accb * s7_ea + (2 * s7_accf - s7_acceb) * (s7_pz + s7_ca);
		s7_z = s7_z + (3 * s7_accc - 2 * s7_acccb + s7_accpi) * s7_fa - 3 * s7_accfb * s7_ba;
		s7_tm2 = s7_im2 + s7_z / (2 * s7_lag);
		s7_z = s7_accf * (s7_pz + 2 * s7_ca) - s7_accfb * s7_ba + (s7_accc - 2 * s7_acccb) * s7_fa;
		s7_tm3 = s7_im3 + 2 * s7_z / s7_lag;
		s7_z = 3 * s7_accf * s7_ea - (s7_accpi + s7_acccb) * (s7_pz + s7_ca) + 2 * (s7_accc - s7_acccb) * s7_ca;
		s7_z = s7_z + (s7_acce - 2 * s7_accfb) * s7_fa - s7_accbb * s7_ba;
		s7_tn1 = s7_in1 + s7_z / (2 * s7_lag);
		s7_z = 3 * s7_accf * s7_ea + (s7_accpi - s7_acccb + 3 * s7_accc) * (s7_pz + 3 * s7_ca);
		s7_z = s7_z - s7_accbb * s7_ba;
		s7_z = s7_z - (s7_accpi + s7_accc) * s7_ca;
		s7_z = s7_z + (s7_acce - 8 * s7_accfb) * s7_fa;
		s7_tn2 = s7_in2 + s7_z / s7_lag;
		s7_z = s7_accf * s7_ea + (3 * s7_accc + s7_accpi - s7_acccb) * (s7_pz + s7_ca) - s7_accbb * s7_ba;
		s7_z = s7_z + (s7_accpi + s7_accc) * s7_ca + (s7_acce - 4 * s7_accfb) * s7_fa;
		s7_tn3 = s7_in3 + s7_z / (2 * s7_lag);
		s7_z = (4 * s7_accc + s7_accpi) * s7_ea - s7_accfb * s7_pz + 2 * (s7_acce - 2 * s7_accfb) * s7_ca;
		s7_z = s7_z - 2 * s7_accbb * s7_fa;
		s7_tc5 = s7_ic5 + s7_z / (4 * s7_lag);
		s7_z = (s7_accpi - 2 * s7_accc) * s7_ea + (4 * s7_acce - s7_accfb) * s7_pz;
		s7_z = s7_z - 2 * s7_accbb * s7_fa;
