		s7_acccb = s7_acccb + s7_cb;
		s7_acceb = s7_acceb + s7_eb;
		s7_accb5 = s7_accb5 + s7_tb5;
		s7_acce5b = s7_acce5b + s7_te5b;
	}
	strcat(bs_ln, " "); bs_out();
	strcat(bs_ln, "Fifth order, per surface, unconverted - same factor as the third order."); bs_out();
