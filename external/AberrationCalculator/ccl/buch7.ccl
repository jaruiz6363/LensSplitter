		strcat(bs_ln, "           tau11          tau12          tau13          tau14          tau15"); bs_out();
		strcat(bs_ln, "  tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][211])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][212])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][213])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][214])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][215])); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, "  int"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][231])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][232])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][233])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][234])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][235])); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, "  ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][211] - s7_tt[s7_i][231])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][212] - s7_tt[s7_i][232])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][213] - s7_tt[s7_i][233])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][214] - s7_tt[s7_i][234])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][215] - s7_tt[s7_i][235])); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, "           tau16          tau17          tau18          tau19          tau20"); bs_out();
		strcat(bs_ln, "  tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][216])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][217])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][218])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][219])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][220])); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, "  int"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][236])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][237])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][238])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][239])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][240])); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, "  ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][216] - s7_tt[s7_i][236])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][217] - s7_tt[s7_i][237])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][218] - s7_tt[s7_i][238])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][219] - s7_tt[s7_i][239])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][220] - s7_tt[s7_i][240])); strcat(bs_ln, bs_tmp); bs_out();
	}
	strcat(bs_ln, " "); bs_out();
	strcat(bs_ln, "Seventh order, system totals, transverse measure"); bs_out();
	strcat(bs_ln, "            tau1           tau2           tau3           tau4           tau5"); bs_out();
	strcat(bs_ln, "  tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[21])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[22])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[23])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[24])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[25])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "  int"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[41])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[42])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[43])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[44])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[45])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "  ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[21] - s7_vec1[41])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[22] - s7_vec1[42])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[23] - s7_vec1[43])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[24] - s7_vec1[44])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[25] - s7_vec1[45])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "            tau6           tau7           tau8           tau9          tau10"); bs_out();
	strcat(bs_ln, "  tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[26])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[27])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[28])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[29])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[30])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "  int"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[46])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[47])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[48])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[49])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[50])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "  ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[26] - s7_vec1[46])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[27] - s7_vec1[47])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[28] - s7_vec1[48])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[29] - s7_vec1[49])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[30] - s7_vec1[50])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "           tau11          tau12          tau13          tau14          tau15"); bs_out();
	strcat(bs_ln, "  tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[31])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[32])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[33])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[34])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[35])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "  int"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[51])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[52])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[53])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[54])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[55])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "  ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[31] - s7_vec1[51])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[32] - s7_vec1[52])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[33] - s7_vec1[53])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[34] - s7_vec1[54])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[35] - s7_vec1[55])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "           tau16          tau17          tau18          tau19          tau20"); bs_out();
	strcat(bs_ln, "  tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[36])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[37])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[38])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[39])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[40])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "  int"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[56])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[57])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[58])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[59])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[60])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "  ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[36] - s7_vec1[56])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[37] - s7_vec1[57])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[38] - s7_vec1[58])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[39] - s7_vec1[59])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec1[40] - s7_vec1[60])); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, " "); bs_out();
	strcat(bs_ln, "tau1 above must equal B7 in the fifth-order totals; the two reach it by"); bs_out();
	strcat(bs_ln, "different routes and agree exactly on a system of spheres."); bs_out();
	strcat(bs_ln, " "); bs_out();
	strcat(bs_ln, "The third and fifth orders above are unconverted per surface - multiply by"); bs_out();
	strcat(bs_ln, "the F/number, which is done for their totals."); bs_out();
	return (0);
}

static int
s7_part7()
{
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		s7_q9v2 = s7_tt[s7_i][156];
		s7_q9v9 = s7_q9v2 * s7_q9v2;
		s7_tt[s7_i][241] = 0;
		s7_tt[s7_i][242] = 0;
		if (s7_i > 1)
		{
			for (s7_m = 1; s7_m <= s7_i - 1; s7_m = s7_m + (1))
			{
				s7_tt[s7_i][241] = s7_tt[s7_i][241] + s7_tt[s7_m][132];
				s7_tt[s7_i][242] = s7_tt[s7_i][242] + s7_tt[s7_m][133];
			}
		}
		s7_q9a = ((s7_tt[s7_i][83] - s7_tt[s7_i][9] - s7_tt[s7_i][20]) * s7_tt[s7_i][15] + s7_tt[s7_i][69]) * s7_tt[s7_i][81] + s7_tt[s7_i][6] * s7_tt[s7_i][241] - s7_tt[s7_i][242];
		s7_q9b = ((0.5 * s7_tt[s7_i][20] + s7_tt[s7_i][9] - s7_tt[s7_i][83]) * s7_tt[s7_i][20] + s7_tt[s7_i][9] * s7_tt[s7_i][83] - s7_tt[s7_i][86]) * s7_tt[s7_i][9];
		s7_q9c = (0.5 * s7_tt[s7_i][15] * s7_tt[s7_i][82] - s7_tt[s7_i][6] * s7_tt[s7_i][70] + s7_tt[s7_i][102]) * s7_tt[s7_i][15] + s7_tt[s7_i][16] * s7_tt[s7_i][86] - s7_tt[s7_i][21] * s7_tt[s7_i][69];
		s7_tt[s7_i][243] = (2.5 * s7_tt[s7_i][83] - 3.0 * s7_tt[s7_i][9]) * s7_tt[s7_i][83] * s7_tt[s7_i][83] + s7_tt[s7_i][20] * s7_tt[s7_i][70] + s7_q9a + s7_q9b + s7_q9c;
		s7_tt[s7_i][244] = 0.25 * (s7_q9v9 - s7_tt[s7_i][9]) * s7_tt[s7_i][10];
		s7_tt[s7_i][245] = (17.0 * s7_tt[s7_i][2] - 9.0 * s7_q9v2) * s7_tt[s7_i][7] * s7_tt[s7_i][244];
		s7_tt[s7_i][246] = (41.0 * s7_q9v2 - 87.0 * s7_tt[s7_i][2]) * s7_tt[s7_i][7] * s7_tt[s7_i][38] / 3.0;
		s7_tt[s7_i][247] = (280.0 * s7_tt[s7_i][34] * s7_tt[s7_i][34] * s7_tt[s7_i][34] + s7_tt[s7_i][245] + s7_tt[s7_i][246]) * s7_tt[s7_i][10] / 8.0;
		s7_q9d = ((-0.5 * s7_tt[s7_i][8] * s7_tt[s7_i][25] - s7_tt[s7_i][48] + s7_tt[s7_i][49]) * s7_tt[s7_i][15] - s7_tt[s7_i][8] * s7_tt[s7_i][69] + s7_tt[s7_i][122]) * s7_tt[s7_i][15];
		s7_q9e = ((s7_tt[s7_i][25] * s7_tt[s7_i][25] + 6.0 * s7_tt[s7_i][101]) * s7_tt[s7_i][25] + 3.0 * s7_tt[s7_i][243]) * s7_tt[s7_i][10];
		s7_q9f = (4.0 * s7_tt[s7_i][15] * s7_tt[s7_i][43] + 7.0 * s7_tt[s7_i][121]) * s7_tt[s7_i][25] + s7_tt[s7_i][43] * s7_tt[s7_i][69];
		s7_tt[s7_i][248] = (2.0 * s7_tt[s7_i][25] * s7_tt[s7_i][25] + s7_tt[s7_i][101]) * 5.0 * s7_tt[s7_i][38] + s7_tt[s7_i][247] + s7_q9d + s7_q9e + s7_q9f;
	}
	s7_q9sum = 0;
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		s7_q9sum = s7_q9sum + s7_tt[s7_i][248];
	}
	s7_up9 = s7_up7 * s7_um * s7_um;
	s7_q9t = s7_q9sum * s7_efac * s7_up9;
	if (s7_q9 == 1)
	{
		strcat(bs_ln, " "); bs_out();
		strcat(bs_ln, "Ninth order - quaternary spherical aberration, per surface"); bs_out();
		strcat(bs_ln, "Buchdahl IV, J. Opt. Soc. Am. 48, 757 (1958), Table I. Unconverted, as the"); bs_out();
		strcat(bs_ln, "third and fifth orders above are. INTRINSIC is what the surface makes on its"); bs_out();
		strcat(bs_ln, "own; TOTAL adds what it makes by acting on the aberration already reaching it."); bs_out();
		strcat(bs_ln, "  surf      intrinsic          total      T1-dagger             r1             r2"); bs_out();
		for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
		{
			sprintf(bs_tmp, "%5.0f", 1.0*(s7_i)); strcat(bs_ln, bs_tmp);
			sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][247])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][248])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][243])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][241])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_tt[s7_i][242])); strcat(bs_ln, bs_tmp); bs_out();
		}
		strcat(bs_ln, " "); bs_out();
		strcat(bs_ln, "Ninth-order spherical, unconverted     "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_q9sum)); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, "Ninth-order spherical, transverse (B9) "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_q9t)); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, " "); bs_out();
		strcat(bs_ln, "The transverse value carries efac * um^9. That extends a rule confirmed at total"); bs_out();
		strcat(bs_ln, "degree seven, and the extension was checked: the ratio of the two lines above"); bs_out();
		strcat(bs_ln, "factors into -(EPD/2)/EFL raised to the ninth and efac = EFL, to six figures."); bs_out();
		strcat(bs_ln, " "); bs_out();
		strcat(bs_ln, "Buchdahl's rule of thumb, from the closing paragraph of paper IV: a system"); bs_out();
		strcat(bs_ln, "intended to work at f/2 should aim at individual contributions of at most"); bs_out();
		strcat(bs_ln, "order 1000 at unit focal length. His own triplet runs to six figures, which"); bs_out();
		strcat(bs_ln, "is why he chose it - it is a poorly corrected system and the table shows it."); bs_out();
	}
	return (0);
}

static int
s7_main()
{
	s7_part1();
	s7_part2();
	s7_part3();
	s7_part4();
	s7_part5();
	s7_part6();
	if (s7_stop) return (0);
	s7_part7();
	return (0);
}

static int
bs_run(int n_q9arg, int n_wavarg)
{
	int    n_i, n_wvn, n_bad, n_infobj, n_nmir;
	double n_sgn, n_t0, n_epup, n_efl, n_epd, n_uobj, n_yobj, n_a_st, n_b_st, n_yA, n_lag, n_n0;
	double n_n0abs, n_pupf, n_nlast, n_fnum, n_objd, n_iota, n_fld, n_p0, n_p0chief;

	bs_nsm = ims - 1;
	if (bs_nsm < 2)
	{
		sprintf(bs_ln, "buch7 needs at least two surfaces before the image (a dummy plane will do).");
		bs_out();
		return (0);
	}
	if (ims + 1 > BS_MAXS)
	{
		sprintf(bs_ln, "buch7 holds at most %d surfaces between object and image.", BS_MAXS - 2);
		bs_out();
		return (0);
	}
	if (n_wavarg > 0)
		n_wvn = n_wavarg;
	else
		n_wvn = +wav + 1;

	// ---- spheres only. Refuse rather than mislead: this arrangement is the spherical one.
	n_bad = 0;
	for (n_i = 1; n_i <= bs_nsm; n_i++)
	{
		if (!(srftyp[n_i] == 0 || srftyp[n_i] == 1 || srftyp[n_i] == 4 || srftyp[n_i] == 5))
		{
			sprintf(bs_ln, "Surface %d is of type %d (OSLO srftyp), not a plane or a sphere.", n_i, srftyp[n_i]);
			bs_out();
			n_bad = 1;
		}
		else if (fabs(cc[n_i]) > 1e-10 || fabs(ad[n_i]) > 0.0 || fabs(ae[n_i]) > 0.0
		         || fabs(af[n_i]) > 0.0 || fabs(ag[n_i]) > 0.0 || (srftyp[n_i] == 5 && asp[n_i] != 0))
		{
			sprintf(bs_ln, "Surface %d carries a conic or an aspheric term.", n_i);
			bs_out();
			n_bad = 1;
		}
	}
	if (n_bad)
	{
		sprintf(bs_ln, "buch7 handles spherical surfaces only. Buchdahl gives the aspheric scheme but never");
		bs_out();
		sprintf(bs_ln, "published the arranged table for it, so this declines rather than guess. buch7_asph,");
		bs_out();
		sprintf(bs_ln, "beside it, is that arrangement reconstructed and carries conics and even aspheres");
		bs_out();
		sprintf(bs_ln, "through the seventh order. Run it on this lens instead.");
		bs_out();
		return (0);
	}

	// ---- the index after each surface, signed by the mirror count
	n_sgn = 1.0;
	n_nmir = 0;
	bs_ns[0] = fabs(rn[0][n_wvn]);
	for (n_i = 1; n_i <= bs_nsm; n_i++)
	{
		if (gltyp[n_i] == 4)
		{
			n_sgn = -n_sgn;
			n_nmir++;
			bs_ns[n_i] = n_sgn*fabs(bs_ns[n_i - 1]);
		}
		else
			bs_ns[n_i] = n_sgn*fabs(rn[n_i][n_wvn]);
	}

	// ---- the two paraxial rays, exactly as ParaxialTrace launches them
	n_infobj = 0;
	n_t0 = fabs(th[0]);
	if (n_t0 >= 1e10)
	{
		n_infobj = 1;
		n_t0 = 0.0;
	}
	if (ast < 1 || ast > bs_nsm)
	{
		sprintf(bs_ln, "No aperture stop between the object and the image.");
		bs_out();
		return (0);
	}
	bs_prop(1.0, 0.0);
	n_a_st = bs_ya[ast];
	n_yA = bs_ns[bs_nsm]*bs_ua[bs_nsm];
	bs_prop(0.0, 1.0);
	n_b_st = bs_ya[ast];
	if (fabs(n_a_st) > 1e-15)
		n_epup = n_b_st/n_a_st;
	else
		n_epup = 0.0;
	if (fabs(n_yA) < 1e-15)
	{
		sprintf(bs_ln, "The system has no focal length; an afocal system is not handled.");
		bs_out();
		return (0);
	}
	n_efl = -bs_ns[0]/n_yA;

	// the marginal ray: from the axial object point to the edge of the entrance pupil
	n_epd = 2.0*(+ebr);
	if (n_infobj)
	{
		n_yobj = 0.5*n_epd;
		n_uobj = 0.0;
	}
	else
	{
		n_uobj = 0.5*n_epd/(n_t0 + n_epup);
		n_yobj = n_uobj*n_t0;
	}
	bs_prop(n_yobj, n_uobj);
	for (n_i = 0; n_i <= bs_nsm; n_i++)
	{
		bs_ym[n_i] = bs_ya[n_i];
		bs_um[n_i] = bs_ua[n_i];
	}

	// the chief ray: from the edge of the field through the centre of the entrance pupil.
	// At infinity the field is ANG; at a finite object it is the object height OBH.
	if (n_infobj)
	{
		n_fld = +ang;
		n_uobj = tan(n_fld);
		n_yobj = -n_uobj*n_epup;
	}
	else
	{
		n_fld = fabs(+obh);
		n_uobj = -n_fld/(n_t0 + n_epup);
		n_yobj = n_fld + n_uobj*n_t0;
	}
	bs_prop(n_yobj, n_uobj);
	for (n_i = 0; n_i <= bs_nsm; n_i++)
	{
		bs_yc[n_i] = bs_ya[n_i];
		bs_uc[n_i] = bs_ua[n_i];
	}

	n_n0 = bs_ns[0];
	n_lag = n_n0*(bs_uc[0]*bs_ym[1] - bs_um[0]*bs_yc[1]);
	n_n0abs = fabs(n_n0);
	if (n_n0abs < 1e-10)
		n_n0abs = 1.0;
	if (fabs(n_lag) < 1e-10)
	{
		sprintf(bs_ln, "The Lagrange invariant is zero. Is the field zero, or the aperture?");
		bs_out();
		return (0);
	}

	n_p0 = n_epup/n_efl;
	n_pupf = bs_um[bs_nsm];
	n_nlast = fabs(bs_ns[bs_nsm]);
	n_fnum = -0.5/n_nlast/n_pupf;
	n_objd = th[0];
	n_iota = 0.0;
	if (!n_infobj)
		n_iota = -n_efl/n_objd;

	sprintf(bs_ln, "BUCH7 (OSLO) - Buchdahl coefficients, spherical surfaces");
	bs_out();
	sprintf(bs_ln, "Wavelength             %d (%.6f um)", n_wvn, wv[n_wvn]);
	bs_out();
	sprintf(bs_ln, "Effective focal length %.6f", n_efl);
	bs_out();
	sprintf(bs_ln, "F/number               %.6f", n_fnum);
	bs_out();
	sprintf(bs_ln, "Lagrange invariant     %.10g", n_lag);
	bs_out();
	sprintf(bs_ln, "Entrance pupil         %.6f from surface 1, radius %.6f", n_epup, 0.5*n_epd);
	bs_out();
	sprintf(bs_ln, "Buchdahl p             %.6f", n_p0);
	bs_out();
	// Buchdahl's p a second time, from the chief ray, as the macro checks it.
	if (fabs(bs_uc[0]) > 1e-10)
	{
		n_p0chief = (bs_yc[1]*(-1.0/bs_uc[0]))/n_efl;
		if (fabs(n_p0chief - n_p0) > 1e-6*(1.0 + fabs(n_p0)))
		{
			sprintf(bs_ln, "WARNING: the entrance pupil and the chief ray disagree about Buchdahl's p");
			bs_out();
			sprintf(bs_ln, "(%.10g and %.10g). The higher orders are built on it; treat them as suspect.", n_p0, n_p0chief);
			bs_out();
		}
	}
	if (n_infobj)
	{
		sprintf(bs_ln, "Object                 at infinity, field angle %.6f deg", n_fld*180.0/pi);
		bs_out();
	}
	else
	{
		sprintf(bs_ln, "Object distance        %.6f, object height %.6f", n_objd, n_fld);
		bs_out();
		sprintf(bs_ln, "Buchdahl iota          %.6f", n_iota);
		bs_out();
	}
	if (n_nmir > 0)
	{
		sprintf(bs_ln, "Reflections            %d", n_nmir);
		bs_out();
	}
	// A lens with no field: OSLO traces its chief ray at a slope of 1e-6 instead. B, B5 and
	// B7 do not depend on the field and are right; everything else is for that made-up field.
	if (fabs(n_uobj) < 1e-5)
	{
		sprintf(bs_ln, "WARNING: the field is OSLO's minimum (chief-ray slope %.1e), not a field of", n_uobj);
		bs_out();
		sprintf(bs_ln, "this lens. Only B, B5 and B7 mean anything; every field-dependent coefficient");
		bs_out();
		sprintf(bs_ln, "below is for that minimum field, and is zero for the lens itself.");
		bs_out();
	}
	sprintf(bs_ln, " ");
	bs_out();

	// ---- the paraxial rays, so they can be set beside OSLO's own (pxt all)
	sprintf(bs_ln, "Paraxial rays (axial: height, slope after; chief: height, slope after)");
	bs_out();
	sprintf(bs_ln, " Srf            PY             PU            PYC            PUC        index after");
	bs_out();
	for (n_i = 0; n_i <= bs_nsm; n_i++)
	{
		sprintf(bs_ln, "%4d %14.8f %14.8f %14.8f %14.8f %14.8f", n_i, bs_ym[n_i], bs_um[n_i], bs_yc[n_i], bs_uc[n_i], bs_ns[n_i]);
		bs_out();
	}
	sprintf(bs_ln, " ");
	bs_out();

	// ==================================================================================
	// Hand over to the macro's own arithmetic, translated statement for statement.
	// ==================================================================================
	s7_zero();
	s7_nsm = bs_nsm;
	s7_eps = 1e-10;
	s7_efl = n_efl;
	s7_epp = n_epup;
	s7_lag = n_lag;
	s7_n0abs = n_n0abs;
	s7_p0 = n_p0;
	s7_fnum = n_fnum;
	s7_nlast = n_nlast;
	s7_objd = n_objd;
	s7_finite = 1 - n_infobj;
	s7_iota = n_iota;
	s7_goe = 1.0 - n_p0*n_iota;
	s7_q9 = n_q9arg;
	for (n_i = 0; n_i <= bs_nsm; n_i++)
	{
		s7_vec2[n_i + 1] = bs_ym[n_i];
		s7_vec2[501 + n_i] = bs_um[n_i];
		s7_vec3[n_i + 1] = bs_yc[n_i];
		s7_vec3[501 + n_i] = bs_uc[n_i];
	}
	strcpy(bs_ln, "");
	s7_stop = 0;
	s7_main();

	sprintf(bs_ln, " ");
	bs_out();
	sprintf(bs_ln, "AberrationCalculator reads this lens file and computes the same coefficients in its C#;");
	bs_out();
	sprintf(bs_ln, "run it on the .len (buchdahl or surface_breakdown) and every number above must agree.");
	bs_out();
	return (0);
}

cmd
buch7(int bs_q9arg, int bs_wavarg, int bs_filearg)
{
	bs_wf = 0;
	if (bs_filearg)
	{
		bs_fh = fopen(BS_REPORT, "at");
		if (bs_fh > 0)
			bs_wf = 1;
		else
			printf("buch7: cannot write %s; carrying on without the report file.\n", BS_REPORT);
	}
	bs_run(bs_q9arg, bs_wavarg);
	if (bs_wf)
	{
		fclose(bs_fh);
		bs_wf = 0;
		printf("Report written to %s\n", BS_REPORT);
	}
}
