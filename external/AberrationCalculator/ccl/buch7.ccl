		strcat(bs_ln, "      ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 56] - s7_vec4[s7_b + 16])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 57] - s7_vec4[s7_b + 17])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 58] - s7_vec4[s7_b + 18])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 59] - s7_vec4[s7_b + 19])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 60] - s7_vec4[s7_b + 20])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 61] - s7_vec4[s7_b + 21])); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, "      tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 56])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 57])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 58])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 59])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 60])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 61])); strcat(bs_ln, bs_tmp); bs_out();
	}
	strcat(bs_ln, " "); bs_out();
	strcat(bs_ln, " Surf                B7      (seventh-order spherical aberration)"); bs_out();
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		s7_b = (s7_i - 1) * 160;
		sprintf(bs_tmp, "%5.0f", 1.0*(s7_i)); strcat(bs_ln, bs_tmp);
		strcat(bs_ln, "  int"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 22])); strcat(bs_ln, bs_tmp); strcat(bs_ln, "  ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 62] - s7_vec4[s7_b + 22])); strcat(bs_ln, bs_tmp); strcat(bs_ln, "  tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 62])); strcat(bs_ln, bs_tmp); bs_out();
	}
	s7_sb5 = 0;
	s7_sf1 = 0;
	s7_sf2 = 0;
	s7_sm1 = 0;
	s7_sm2 = 0;
	s7_sm3 = 0;
	s7_sn1 = 0;
	s7_sn2 = 0;
	s7_sn3 = 0;
	s7_sc5 = 0;
	s7_sp5 = 0;
	s7_se5 = 0;
	s7_sb7 = 0;
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		s7_b = (s7_i - 1) * 160;
		s7_sb5 = s7_sb5 + s7_vec4[s7_b + 50];
		s7_sf1 = s7_sf1 + s7_vec4[s7_b + 51];
		s7_sf2 = s7_sf2 + s7_vec4[s7_b + 52];
		s7_sm1 = s7_sm1 + s7_vec4[s7_b + 53];
		s7_sm2 = s7_sm2 + s7_vec4[s7_b + 54];
		s7_sm3 = s7_sm3 + s7_vec4[s7_b + 55];
		s7_sn1 = s7_sn1 + s7_vec4[s7_b + 56];
		s7_sn2 = s7_sn2 + s7_vec4[s7_b + 57];
		s7_sn3 = s7_sn3 + s7_vec4[s7_b + 58];
		s7_sc5 = s7_sc5 + s7_vec4[s7_b + 59];
		s7_sp5 = s7_sp5 + s7_vec4[s7_b + 60];
		s7_se5 = s7_se5 + s7_vec4[s7_b + 61];
		s7_sb7 = s7_sb7 + s7_vec4[s7_b + 62];
	}
	strcat(bs_ln, " "); bs_out();
	strcat(bs_ln, "System totals, transverse measure"); bs_out();
	strcat(bs_ln, "   B  "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sumb * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   F  "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sumf * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   C  "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sumc * s7_fnum)); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "   Pi "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sump * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   E  "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sume * s7_fnum)); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "   B5 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sb5 * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   F1 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sf1 * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   F2 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sf2 * s7_fnum)); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "   M1 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sm1 * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   M2 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sm2 * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   M3 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sm3 * s7_fnum)); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "   N1 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sn1 * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   N2 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sn2 * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   N3 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sn3 * s7_fnum)); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "   C5 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sc5 * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   Pi5"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sp5 * s7_fnum)); strcat(bs_ln, bs_tmp); strcat(bs_ln, "   E5 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_se5 * s7_fnum)); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, "   B7 "); sprintf(bs_tmp, "%15.6e", 1.0*(s7_sb7 * s7_fnum)); strcat(bs_ln, bs_tmp); bs_out();
	strcat(bs_ln, " "); bs_out();
	s7_dbg = 1;
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		for (s7_j = 1; s7_j <= 249; s7_j = s7_j + (1))
		{
			s7_tt[s7_i][s7_j] = 0;
		}
	}
	s7_typ = 1;
	s7_tvp = s7_iota;
	s7_tyq = s7_p0 / s7_goe / s7_n0abs;
	s7_tvq = 1 / s7_goe / s7_n0abs;
	return (0);
}

static int
s7_part3()
{
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		s7_cvn = cv[s7_i] * s7_efl;
		s7_nb = bs_ns[s7_i - 1];
		s7_na = bs_ns[s7_i];
		if (fabs(s7_na) < s7_eps) { s7_na = 1; }
		s7_kk = s7_nb / s7_na;
		if (s7_i > 1)
		{
			s7_dgap = th[s7_i - 1] / s7_efl;
			s7_typ = s7_typ - s7_dgap * s7_tvp;
			s7_tyq = s7_tyq - s7_dgap * s7_tvq;
		}
		s7_tt[s7_i][1] = s7_typ;
		s7_tt[s7_i][2] = s7_tvp;
		s7_tt[s7_i][3] = s7_cvn * s7_typ - s7_tvp;
		s7_tt[s7_i][4] = s7_tyq;
		s7_tt[s7_i][5] = s7_tvq;
		s7_tiq = s7_cvn * s7_tyq - s7_tvq;
		if (fabs(s7_tt[s7_i][3]) > 1E-30)
		{
			s7_tt[s7_i][6] = s7_tiq / s7_tt[s7_i][3];
		}
		else
		{
			s7_tt[s7_i][6] = 0;
		}
		s7_tt[s7_i][7] = -s7_tvp * s7_tt[s7_i][6] + s7_tvq;
		s7_tt[s7_i][8] = (s7_kk - 1) * s7_cvn / s7_nb;
		s7_tt[s7_i][9] = s7_tvp * s7_tvp;
		s7_tt[s7_i][156] = (1 - s7_kk) * s7_cvn * s7_typ + s7_kk * s7_tvp;
		s7_tt[s7_i][157] = (1 - s7_kk) * s7_cvn * s7_tyq + s7_kk * s7_tvq;
		s7_tlag = s7_tt[s7_i][5] * s7_tt[s7_i][1] - s7_tt[s7_i][2] * s7_tt[s7_i][4];
		if (fabs(s7_tlag) > 1E-30)
		{
			s7_gg = 0.5 * (s7_tt[s7_i][156] - s7_tt[s7_i][3]) * (s7_kk - 1) * s7_tt[s7_i][1] / s7_tlag;
		}
		else
		{
			s7_gg = 0;
		}
		s7_tt[s7_i][10] = s7_gg * s7_tt[s7_i][3] * s7_tt[s7_i][3];
		s7_tt[s7_i][11] = s7_gg * s7_tt[s7_i][3] * s7_tiq;
		s7_tt[s7_i][12] = 2 * s7_gg * s7_tiq * s7_tiq;
		s7_tt[s7_i][13] = s7_gg * s7_tiq * s7_tiq - 0.5 * s7_tt[s7_i][8];
		if (fabs(s7_tt[s7_i][3]) > 1E-30)
		{
			s7_coi = s7_cvn / s7_tt[s7_i][3];
		}
		else
		{
			if (fabs(s7_tt[s7_i][2]) < 1E-30)
			{
				s7_coi = 1 / s7_tt[s7_i][1];
			}
			else
			{
				s7_coi = 0;
			}
		}
		s7_tiq3 = s7_tiq * s7_tiq * s7_tiq;
		if (fabs(s7_tlag) > 1E-30)
		{
			s7_z = s7_coi * (s7_tt[s7_i][1] * s7_tt[s7_i][1] * s7_tiq3 / s7_tlag - s7_tiq / s7_nb);
			s7_z = s7_z - (1 + s7_kk) * s7_tt[s7_i][1] * s7_tiq3 / s7_tlag;
			s7_tt[s7_i][14] = 0.5 * (s7_kk - 1) * s7_z;
		}
		else
		{
			s7_tt[s7_i][14] = 0;
		}
		s7_tt[s7_i][158] = s7_coi;
		s7_tt[s7_i][159] = s7_kk;
		s7_tt[s7_i][160] = s7_nb;
		s7_tvp = s7_tt[s7_i][156];
		s7_tvq = s7_tt[s7_i][157];
	}
	for (s7_i = 1; s7_i <= s7_nsm; s7_i = s7_i + (1))
	{
		for (s7_j = 10; s7_j <= 14; s7_j = s7_j + (1))
		{
			s7_z = 0;
			if (s7_i > 1)
			{
