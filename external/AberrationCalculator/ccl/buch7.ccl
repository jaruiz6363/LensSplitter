static double    s7_q4p, s7_q5p, s7_q6p, s7_q9a, s7_q9b, s7_q9c, s7_q9d, s7_q9e, s7_q9f, s7_q9sum;
static double    s7_q9t, s7_q9v2, s7_q9v9, s7_qcc, s7_qom, s7_qq, s7_qr, s7_sb5, s7_sb7, s7_sc5;
static double    s7_se5, s7_sf1, s7_sf2, s7_sfc, s7_sfm, s7_sm1, s7_sm2, s7_sm3, s7_sn1, s7_sn2;
static double    s7_sn3, s7_sp5, s7_ss1, s7_ss2, s7_ss3, s7_ss4, s7_ss5, s7_ss6, s7_sumb, s7_sumc;
static double    s7_sume, s7_sumf, s7_sump, s7_t1p, s7_t2s, s7_t81s, s7_t9s, s7_tb5, s7_tb7, s7_tc5;
static double    s7_tcar, s7_te5, s7_te5b, s7_tf1, s7_tf2, s7_tiq, s7_tiq3, s7_tlag, s7_tm1, s7_tm2;
static double    s7_tm3, s7_tn1, s7_tn2, s7_tn3, s7_tp5, s7_tvp, s7_tvq, s7_typ, s7_tyq, s7_u1;
