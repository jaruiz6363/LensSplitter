static int
s7_zero()
{
	int zi, zj;
	for (zi = 0; zi < 19; zi++) for (zj = 0; zj < 251; zj++) s7_tt[zi][zj] = 0;
	for (zi = 0; zi < 64; zi++) s7_vec1[zi] = 0.0;
	for (zi = 0; zi < 520; zi++) s7_vec2[zi] = 0.0;
	for (zi = 0; zi < 520; zi++) s7_vec3[zi] = 0.0;
	for (zi = 0; zi < 2640; zi++) s7_vec4[zi] = 0.0;
	return (0);
}

