/**********************************************************************
* cmd buch7 - third-, fifth- and seventh-order Buchdahl coefficients of a
* centred system of SPHERICAL surfaces, per surface, split into the part
* each surface generates on its own and the part it generates by acting
* on the aberration already present when light reaches it; and, on
* request, the ninth-order spherical aberration.
*
* Written by Javier Ruiz with Claude Code, September 2026. The OSLO port
* of macros/BUCH7.ZPL in C:\GIT\AberrationCalculator. The front end
* (lens data, the two paraxial rays) is written for OSLO; everything from
* the macro's stage A on is translated from the macro statement for
* statement by tools/zpl2ccl, so the arithmetic is the macro's own. The
* macro and this program's C# are the references it is checked against.
*
* REFERENCES
*
*   H. A. Buchdahl, "Optical Aberration Coefficients", Dover 1968:
*   Secs. 31, 203 and 218 (the third and fifth order) and Chapter VI (the
*   tertiary, the seventh order).
*   H. A. Buchdahl, J. Opt. Soc. Am. 48, 563 (1958) (paper II) and 48, 747
*   (1958) (paper III, Tables I and II).
*   H. A. Buchdahl, "Optical aberration coefficients. IV. The coefficient
*   of quaternary spherical aberration", J. Opt. Soc. Am. 48, 757 (1958).
*
* WHAT IT PRINTS
*
*   Every surface's third order (B F C Pi E), fifth order (B5 F1 F2 M1 M2
*   M3 N1 N2 N3 C5 Pi5 E5) and the twenty seventh-order tau, split into
*   the INTRINSIC part, which the surface generates from its own curvature
*   and the rays arriving at it, and the INDUCED part, which it generates
*   by acting on the aberration already accumulated ahead of it. There is
*   no induced part at third order. The totals are in transverse measure.
*
*   With the first argument 1, also the ninth-order (quaternary) spherical
*   aberration per surface.
*
* RUNNING IT
*
*   buch7                    current wavelength, report file
*   buch7 1                  and the ninth-order spherical aberration
*   buch7 0 2                at wavelength 2
*   buch7 0 0 0              without the report file
*
*   Each run is added to the end of BS_REPORT (below), as well as going to
*   the text window, so several lenses can be run into one file. Set it to
*   a folder that exists; if it cannot be written, buch7 says so and
*   carries on without it.
*
* LIMITS
*
*   Spherical and plane surfaces only. A conic or an aspheric term (AD to
*   AG) makes it stop and point to buch7_asph, which carries them through
*   the seventh order; there is no ninth order for a figured surface
*   anywhere. At least two surfaces between object and image (a dummy
*   plane will do), at most 16. Rotationally symmetric and sequential;
*   either conjugate; mirrors are carried in the sign of the index.
**********************************************************************/

#define BS_REPORT  "C:/GIT/AberrationCalculator/ccl/buch7.txt"
#define BS_MAXS    18

int bs_q9arg   {prompt = "Ninth-order spherical aberration (0 = no, 1 = yes)", lolim = 0, hilim = 1, default(noquery) = 0}
int bs_wavarg  {prompt = "Wavelength number (0 = the current one)", lolim = 0, hilim = 10, default(noquery) = 0}
int bs_filearg {prompt = "Also write the report file BS_REPORT (0 = no, 1 = yes)", lolim = 0, hilim = 1, default(noquery) = 1}

static double bs_ns[BS_MAXS];        // index after surface i, signed by the mirror count
static double bs_ya[BS_MAXS], bs_ua[BS_MAXS];   // basis ray, and the scratch the trace writes
static double bs_ym[BS_MAXS], bs_um[BS_MAXS];   // marginal: height at i, slope after i
static double bs_yc[BS_MAXS], bs_uc[BS_MAXS];   // chief
static int    bs_nsm;
static int    bs_fh, bs_wf;
static char   bs_ln[400];

// One line to the text window and, if it is open, the report.
static cmd
bs_out()
{
	printf("%s\n", bs_ln);
	if (bs_wf)
		fprintf(bs_fh, "%s\n", bs_ln);
	strcpy(bs_ln, "");
}

// The paraxial ray with height y1 at surface 1 and slope u0 in object space, through every
// optical surface: bs_ya[i] its height at surface i, bs_ua[i] its slope after surface i,
// bs_ua[0] the object-space slope. The same recurrence as ParaxialTrace.Propagate.
static int
bs_prop(double sp_y1, double sp_u0)
{
	int    sp_i;
	double sp_om;

	bs_ua[0] = sp_u0;
	bs_ya[0] = 0.0;
	sp_om = bs_ns[0]*sp_u0;
	bs_ya[1] = sp_y1;
	for (sp_i = 1; sp_i <= bs_nsm; sp_i++)
	{
		sp_om = sp_om - bs_ya[sp_i]*(bs_ns[sp_i] - bs_ns[sp_i - 1])*cv[sp_i];
		bs_ua[sp_i] = sp_om/bs_ns[sp_i];
		if (sp_i < bs_nsm)
			bs_ya[sp_i + 1] = bs_ya[sp_i] + th[sp_i]*bs_ua[sp_i];
	}
	return (0);
}

