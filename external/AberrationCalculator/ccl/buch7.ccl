		strcat(bs_ln, "      ind"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 50] - s7_vec4[s7_b + 10])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 51] - s7_vec4[s7_b + 11])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 52] - s7_vec4[s7_b + 12])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 53] - s7_vec4[s7_b + 13])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 54] - s7_vec4[s7_b + 14])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 55] - s7_vec4[s7_b + 15])); strcat(bs_ln, bs_tmp); bs_out();
		strcat(bs_ln, "      tot"); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 50])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 51])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 52])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 53])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 54])); strcat(bs_ln, bs_tmp); sprintf(bs_tmp, "%15.6e", 1.0*(s7_vec4[s7_b + 55])); strcat(bs_ln, bs_tmp); bs_out();
